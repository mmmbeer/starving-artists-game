# Server Port
PORT=4000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PORT=3306
DB_PASSWORD=your_password
DB_NAME=starving_artists

# Realtime Configuration
# For shared hosting, Socket.IO is primary, WebSocket is fallback
REALTIME_SOCKET_IO_ENABLED=true
REALTIME_WSS_ENABLED=true
SOCKET_IO_PATH=/socket.io

# CORS Origins (comma-separated)
# For single domain setup, use your primary domain
ALLOWED_ORIGINS=http://localhost:5173,https://www.starvingartistsgame.com,https://starvingartistsgame.com
