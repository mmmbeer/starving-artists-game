<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/themes/default.css">
  <style>
    .admin-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: white;
      padding: 1rem 0;
    }
    .editor-container {
      display: grid;
      grid-template-columns: 1fr 350px;
      gap: 1.5rem;
      height: calc(100vh - 160px);
    }
    .canvas-workspace {
      background: #1f2937;
      border-radius: 12px;
      padding: 1rem;
      overflow: auto;
      position: relative;
    }
    .canvas-container {
      position: relative;
      display: inline-block;
      cursor: crosshair;
    }
    .canvas-image {
      max-width: 100%;
      height: auto;
      display: block;
    }
    .square-overlay {
      position: absolute;
      border: 2px solid rgba(255, 255, 255, 0.8);
      background: rgba(59, 130, 246, 0.3);
      cursor: move;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      color: white;
      font-weight: bold;
      border-radius: 4px;
    }
    .square-overlay:hover {
      border-color: #F59E0B;
      background: rgba(245, 158, 11, 0.3);
    }
    .square-overlay.selected {
      border-color: #10B981;
      border-width: 3px;
      background: rgba(16, 185, 129, 0.3);
    }
    .square-overlay .delete-btn {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 18px;
      height: 18px;
      background: #EF4444;
      border-radius: 50%;
      color: white;
      font-size: 12px;
      line-height: 18px;
      text-align: center;
      cursor: pointer;
      display: none;
    }
    .square-overlay:hover .delete-btn {
      display: block;
    }
    .settings-panel {
      background: white;
      border-radius: 12px;
      padding: 1.5rem;
      overflow-y: auto;
    }
    .color-checkbox {
      display: inline-flex;
      align-items: center;
      margin-right: 0.5rem;
      margin-bottom: 0.5rem;
    }
    .color-checkbox input {
      margin-right: 0.25rem;
    }
    .color-swatch {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      display: inline-block;
      margin-left: 4px;
      border: 1px solid #ccc;
    }
    .color-swatch.red { background: #EF4444; }
    .color-swatch.orange { background: #F97316; }
    .color-swatch.yellow { background: #EAB308; }
    .color-swatch.green { background: #22C55E; }
    .color-swatch.blue { background: #3B82F6; }
    .color-swatch.purple { background: #A855F7; }
    .color-swatch.black { background: #1F2937; }
    .square-list {
      max-height: 200px;
      overflow-y: auto;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .square-list-item {
      padding: 0.5rem;
      border-bottom: 1px solid #e5e7eb;
      cursor: pointer;
      font-size: 0.85rem;
    }
    .square-list-item:hover {
      background: #f3f4f6;
    }
    .square-list-item.selected {
      background: #dbeafe;
    }
    .toolbar {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding: 0.5rem;
      background: #374151;
      border-radius: 8px;
    }
    .toolbar button {
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.85rem;
    }
    .toolbar button.active {
      background: #3B82F6;
      color: white;
    }
    .info-text {
      font-size: 0.8rem;
      color: #6b7280;
      margin-top: 0.5rem;
    }
    .preview-colors {
      display: flex;
      gap: 2px;
      margin-top: 4px;
    }
    .preview-colors .mini-swatch {
      width: 12px;
      height: 12px;
      border-radius: 2px;
    }
  </style>
</head>
<body>
  <header class="admin-header">
    <div class="container-fluid">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <a href="/admin/canvases" class="text-white-50 text-decoration-none">← All Canvases</a>
          <h1 class="h4 mb-0 mt-1"><%= fileInfo.title %></h1>
          <small class="text-white-50"><%= fileInfo.artist %> <% if (fileInfo.year) { %>(<%= fileInfo.year %>)<% } %></small>
        </div>
        <div class="d-flex gap-2">
          <button id="saveBtn" class="btn btn-success">💾 Save Canvas</button>
          <a href="/admin/canvases" class="btn btn-outline-light">Cancel</a>
        </div>
      </div>
    </div>
  </header>

  <main class="p-3">
    <div class="editor-container">
      <!-- Canvas Workspace -->
      <div class="canvas-workspace">
        <div class="toolbar">
          <button id="addModeBtn" class="active">➕ Add Squares</button>
          <button id="selectModeBtn">🖱️ Select Mode</button>
          <button id="clearAllBtn">🗑️ Clear All</button>
          <span class="text-white ms-auto small">Click on canvas to add paint squares. Drag to move.</span>
        </div>
        <div class="canvas-container" id="canvasContainer">
          <img 
            src="<%= fileInfo.fullPath %>" 
            alt="<%= fileInfo.title %>"
            class="canvas-image"
            id="canvasImage"
          >
          <div id="squaresOverlay"></div>
        </div>
      </div>

      <!-- Settings Panel -->
      <div class="settings-panel">
        <h5 class="mb-3">Canvas Settings</h5>
        
        <form id="canvasForm">
          <input type="hidden" name="id" value="<%= canvas ? canvas.id : '' %>">
          <input type="hidden" name="filename" value="<%= fileInfo.filename %>">
          
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" value="<%= canvas ? canvas.name : fileInfo.title %>" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Artist</label>
            <input type="text" class="form-control" name="artist" value="<%= canvas ? canvas.artist : fileInfo.artist %>">
          </div>
          
          <div class="mb-3">
            <label class="form-label">Year</label>
            <input type="text" class="form-control" name="year" value="<%= canvas ? canvas.year : fileInfo.year || '' %>">
          </div>
          
          <div class="row mb-3">
            <div class="col-4">
              <label class="form-label">⭐ Stars</label>
              <input type="number" class="form-control" name="star_value" 
                     value="<%= canvas ? canvas.star_value : defaultValues.star_value %>" min="1" max="10">
            </div>
            <div class="col-4">
              <label class="form-label">🎨 Paint</label>
              <input type="number" class="form-control" name="paint_value" 
                     value="<%= canvas ? canvas.paint_value : defaultValues.paint_value %>" min="1" max="10">
            </div>
            <div class="col-4">
              <label class="form-label">🍎 Food</label>
              <input type="number" class="form-control" name="food_value" 
                     value="<%= canvas ? canvas.food_value : defaultValues.food_value %>" min="0" max="10">
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Orientation</label>
            <select class="form-select" name="orientation">
              <option value="landscape" <%= canvas && canvas.layout_json?.orientation === 'landscape' ? 'selected' : '' %>>Landscape</option>
              <option value="portrait" <%= canvas && canvas.layout_json?.orientation === 'portrait' ? 'selected' : '' %>>Portrait</option>
            </select>
          </div>
        </form>

        <hr>
        
        <!-- Square Editor -->
        <h6 class="mb-2">Paint Squares (<span id="squareCount">0</span>)</h6>
        <p class="info-text">Click on the canvas to add squares. Select a square to edit its colors.</p>
        
        <div class="square-list mb-3" id="squareList">
          <!-- Populated by JS -->
        </div>
        
        <!-- Selected Square Colors -->
        <div id="selectedSquareEditor" style="display: none;">
          <h6 class="mb-2">Allowed Colors</h6>
          <div id="colorCheckboxes">
            <label class="color-checkbox">
              <input type="checkbox" value="red"> Red <span class="color-swatch red"></span>
            </label>
            <label class="color-checkbox">
              <input type="checkbox" value="orange"> Orange <span class="color-swatch orange"></span>
            </label>
            <label class="color-checkbox">
              <input type="checkbox" value="yellow"> Yellow <span class="color-swatch yellow"></span>
            </label>
            <label class="color-checkbox">
              <input type="checkbox" value="green"> Green <span class="color-swatch green"></span>
            </label>
            <label class="color-checkbox">
              <input type="checkbox" value="blue"> Blue <span class="color-swatch blue"></span>
            </label>
            <label class="color-checkbox">
              <input type="checkbox" value="purple"> Purple <span class="color-swatch purple"></span>
            </label>
            <label class="color-checkbox">
              <input type="checkbox" value="black"> Black <span class="color-swatch black"></span>
            </label>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // State
    let squares = [];
    let selectedSquareIndex = -1;
    let mode = 'add'; // 'add' or 'select'
    let isDragging = false;
    let dragOffset = { x: 0, y: 0 };
    let squareSize = 30; // Default square size in pixels
    
    // Load existing squares
    <% if (canvas && canvas.layout_json && canvas.layout_json.squares) { %>
      squares = <%- JSON.stringify(canvas.layout_json.squares) %>;
    <% } %>
    
    // DOM elements
    const canvasContainer = document.getElementById('canvasContainer');
    const canvasImage = document.getElementById('canvasImage');
    const squaresOverlay = document.getElementById('squaresOverlay');
    const squareList = document.getElementById('squareList');
    const squareCountEl = document.getElementById('squareCount');
    const selectedSquareEditor = document.getElementById('selectedSquareEditor');
    const colorCheckboxes = document.querySelectorAll('#colorCheckboxes input[type="checkbox"]');
    
    // Mode buttons
    document.getElementById('addModeBtn').addEventListener('click', () => {
      mode = 'add';
      document.getElementById('addModeBtn').classList.add('active');
      document.getElementById('selectModeBtn').classList.remove('active');
      canvasContainer.style.cursor = 'crosshair';
    });
    
    document.getElementById('selectModeBtn').addEventListener('click', () => {
      mode = 'select';
      document.getElementById('selectModeBtn').classList.add('active');
      document.getElementById('addModeBtn').classList.remove('active');
      canvasContainer.style.cursor = 'default';
    });
    
    document.getElementById('clearAllBtn').addEventListener('click', () => {
      if (confirm('Remove all squares?')) {
        squares = [];
        selectedSquareIndex = -1;
        renderSquares();
      }
    });
    
    // Add square on click
    canvasContainer.addEventListener('click', (e) => {
      if (mode !== 'add' || isDragging) return;
      if (e.target.classList.contains('square-overlay') || e.target.classList.contains('delete-btn')) return;
      
      const rect = canvasImage.getBoundingClientRect();
      const x = Math.round(e.clientX - rect.left);
      const y = Math.round(e.clientY - rect.top);
      
      // Create new square
      const newSquare = {
        id: `sq-${Date.now()}`,
        position: { x, y },
        allowedColors: ['red'], // Default color
      };
      
      squares.push(newSquare);
      selectedSquareIndex = squares.length - 1;
      renderSquares();
    });
    
    // Render squares
    function renderSquares() {
      squaresOverlay.innerHTML = '';
      squareList.innerHTML = '';
      squareCountEl.textContent = squares.length;
      
      squares.forEach((sq, index) => {
        // Create overlay element
        const div = document.createElement('div');
        div.className = 'square-overlay' + (index === selectedSquareIndex ? ' selected' : '');
        div.style.left = sq.position.x + 'px';
        div.style.top = sq.position.y + 'px';
        div.style.width = squareSize + 'px';
        div.style.height = squareSize + 'px';
        div.textContent = index + 1;
        div.dataset.index = index;
        
        // Color preview
        const firstColor = sq.allowedColors[0] || 'red';
        div.style.borderColor = getColorHex(firstColor);
        
        // Delete button
        const deleteBtn = document.createElement('div');
        deleteBtn.className = 'delete-btn';
        deleteBtn.textContent = '×';
        deleteBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          squares.splice(index, 1);
          if (selectedSquareIndex >= squares.length) selectedSquareIndex = -1;
          renderSquares();
        });
        div.appendChild(deleteBtn);
        
        // Click to select
        div.addEventListener('click', (e) => {
          e.stopPropagation();
          selectSquare(index);
        });
        
        // Drag functionality
        div.addEventListener('mousedown', (e) => {
          if (e.target.classList.contains('delete-btn')) return;
          isDragging = true;
          dragOffset = {
            x: e.clientX - sq.position.x,
            y: e.clientY - sq.position.y
          };
          selectSquare(index);
        });
        
        squaresOverlay.appendChild(div);
        
        // Create list item
        const li = document.createElement('div');
        li.className = 'square-list-item' + (index === selectedSquareIndex ? ' selected' : '');
        li.innerHTML = `
          <strong>#${index + 1}</strong> (${sq.position.x}, ${sq.position.y})
          <div class="preview-colors">
            ${sq.allowedColors.map(c => `<div class="mini-swatch" style="background: ${getColorHex(c)}"></div>`).join('')}
          </div>
        `;
        li.addEventListener('click', () => selectSquare(index));
        squareList.appendChild(li);
      });
      
      updateSelectedSquareEditor();
    }
    
    // Mouse move for dragging
    document.addEventListener('mousemove', (e) => {
      if (!isDragging || selectedSquareIndex < 0) return;
      
      const rect = canvasImage.getBoundingClientRect();
      const x = Math.round(e.clientX - rect.left - squareSize / 2);
      const y = Math.round(e.clientY - rect.top - squareSize / 2);
      
      // Clamp to canvas bounds
      squares[selectedSquareIndex].position.x = Math.max(0, Math.min(x, canvasImage.width - squareSize));
      squares[selectedSquareIndex].position.y = Math.max(0, Math.min(y, canvasImage.height - squareSize));
      
      renderSquares();
    });
    
    document.addEventListener('mouseup', () => {
      isDragging = false;
    });
    
    // Select square
    function selectSquare(index) {
      selectedSquareIndex = index;
      renderSquares();
    }
    
    // Update selected square editor
    function updateSelectedSquareEditor() {
      if (selectedSquareIndex < 0 || selectedSquareIndex >= squares.length) {
        selectedSquareEditor.style.display = 'none';
        return;
      }
      
      selectedSquareEditor.style.display = 'block';
      const sq = squares[selectedSquareIndex];
      
      colorCheckboxes.forEach(cb => {
        cb.checked = sq.allowedColors.includes(cb.value);
      });
    }
    
    // Color checkbox change
    colorCheckboxes.forEach(cb => {
      cb.addEventListener('change', () => {
        if (selectedSquareIndex < 0) return;
        
        const selectedColors = Array.from(colorCheckboxes)
          .filter(c => c.checked)
          .map(c => c.value);
        
        // Ensure at least one color is selected
        if (selectedColors.length === 0) {
          cb.checked = true;
          return;
        }
        
        squares[selectedSquareIndex].allowedColors = selectedColors;
        renderSquares();
      });
    });
    
    // Color helper
    function getColorHex(color) {
      const colors = {
        red: '#EF4444',
        orange: '#F97316',
        yellow: '#EAB308',
        green: '#22C55E',
        blue: '#3B82F6',
        purple: '#A855F7',
        black: '#1F2937',
      };
      return colors[color] || '#888';
    }
    
    // Save canvas
    document.getElementById('saveBtn').addEventListener('click', async () => {
      const form = document.getElementById('canvasForm');
      const formData = new FormData(form);
      
      const data = {
        id: formData.get('id') || null,
        filename: formData.get('filename'),
        name: formData.get('name'),
        artist: formData.get('artist'),
        year: formData.get('year'),
        star_value: formData.get('star_value'),
        paint_value: formData.get('paint_value'),
        food_value: formData.get('food_value'),
        orientation: formData.get('orientation'),
        squares: squares,
      };
      
      try {
        const response = await fetch('/admin/api/canvas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert('Canvas saved successfully!');
          // Update the hidden ID field
          document.querySelector('input[name="id"]').value = result.canvas.id;
        } else {
          alert('Error: ' + (result.error || 'Failed to save'));
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    });
    
    // Initial render
    renderSquares();
  </script>
</body>
</html>
