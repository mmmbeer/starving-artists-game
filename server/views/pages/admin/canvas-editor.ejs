<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/themes/default.css">
  <style>
    .admin-header {
      background: #0f172a;
      color: white;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      height: 48px;
      display: flex;
      align-items: center;
    }
    .header-ribbon {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      width: 100%;
      font-size: 0.9rem;
    }
    .header-ribbon .header-title {
      text-align: center;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .header-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }
    .editor-container {
      display: grid;
      grid-template-columns: 1fr 350px;
      gap: 1.5rem;
      height: calc(100vh - 72px);
    }
    .canvas-workspace {
      background: #1f2937;
      border-radius: 12px;
      padding: 1rem;
      overflow: auto;
      position: relative;
    }
    .canvas-container {
      position: relative;
      display: inline-block;
      cursor: crosshair;
      transform-origin: top left;
    }
    .canvas-image {
      display: block;
    }
    #squaresOverlay {
      position: absolute;
      top: 0;
      left: 0;
    }
    .square-overlay {
      position: absolute;
      border: 2px solid rgba(255, 255, 255, 0.8);
      background: rgba(59, 130, 246, 0.3);
      cursor: move;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 10px;
      color: white;
      font-weight: bold;
      border-radius: 4px;
    }
    .square-overlay:hover {
      border-color: #F59E0B;
      background: rgba(245, 158, 11, 0.3);
    }
    .square-overlay.selected {
      border-color: #10B981;
      border-width: 3px;
      background: rgba(16, 185, 129, 0.3);
    }
    .square-overlay .delete-btn {
      position: absolute;
      top: -8px;
      right: -8px;
      width: 18px;
      height: 18px;
      background: #EF4444;
      border-radius: 50%;
      color: white;
      font-size: 12px;
      line-height: 18px;
      text-align: center;
      cursor: pointer;
      display: none;
    }
    .square-overlay:hover .delete-btn {
      display: block;
    }
    .settings-panel {
      background: white;
      border-radius: 12px;
      padding: 1.5rem;
      overflow-y: auto;
    }
    .square-list {
      max-height: 360px;
      overflow-y: auto;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .square-list-item {
      padding: 0.35rem 0.5rem;
      border-bottom: 1px solid #e5e7eb;
      cursor: pointer;
      font-size: 0.85rem;
    }
    .square-list-item:hover {
      background: #f3f4f6;
    }
    .square-list-item.selected {
      background: #dbeafe;
    }
    .toolbar {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding: 0.5rem;
      background: #374151;
      border-radius: 8px;
    }
    .toolbar button {
      padding: 0.5rem 1rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-size: 0.85rem;
    }
    .toolbar button.active {
      background: #3B82F6;
      color: white;
    }
    .color-ribbon {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      padding: 0.5rem;
      margin-top: -0.5rem;
      margin-bottom: 1rem;
      background: #2b3440;
      border-radius: 8px;
      align-items: center;
    }
    .color-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      color: #e5e7eb;
      font-size: 0.8rem;
      user-select: none;
    }
    .color-toggle input {
      width: 14px;
      height: 14px;
      margin: 0;
    }
    .color-toggle.red input { accent-color: #EF4444; }
    .color-toggle.orange input { accent-color: #F97316; }
    .color-toggle.yellow input { accent-color: #EAB308; }
    .color-toggle.green input { accent-color: #22C55E; }
    .color-toggle.blue input { accent-color: #3B82F6; }
    .color-toggle.purple input { accent-color: #A855F7; }
    .color-toggle.black input { accent-color: #111827; }
    .info-text {
      font-size: 0.8rem;
      color: #6b7280;
      margin-top: 0.5rem;
    }
    .square-grid-header,
    .square-grid-row,
    .square-grid-total {
      display: grid;
      grid-template-columns: minmax(120px, 1fr) repeat(7, 22px);
      align-items: center;
      gap: 4px;
    }
    .square-grid-header {
      padding: 0.35rem 0.5rem;
      background: #f8fafc;
      border-bottom: 1px solid #e5e7eb;
      font-size: 0.75rem;
      font-weight: 600;
      color: #64748b;
      position: sticky;
      top: 0;
      z-index: 2;
    }
    .square-grid-row {
      padding: 0.3rem 0.5rem;
    }
    .square-grid-row.selected {
      background: #dbeafe;
    }
    .square-label {
      font-size: 0.8rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .color-cell {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      border: 1px solid #d1d5db;
      background: #f3f4f6;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      cursor: pointer;
      user-select: none;
    }
    .color-cell.active {
      color: #fff;
      border-color: transparent;
    }
    .color-cell.active.yellow { color: #1f2937; }
    .color-cell.red.active { background: #EF4444; }
    .color-cell.orange.active { background: #F97316; }
    .color-cell.yellow.active { background: #EAB308; }
    .color-cell.green.active { background: #22C55E; }
    .color-cell.blue.active { background: #3B82F6; }
    .color-cell.purple.active { background: #A855F7; }
    .color-cell.black.active { background: #111827; }
    .square-grid-total {
      padding: 0.4rem 0.5rem;
      border-top: 1px solid #e5e7eb;
      background: #f8fafc;
      font-size: 0.75rem;
      font-weight: 600;
      color: #475569;
      position: sticky;
      bottom: 0;
      z-index: 2;
    }
    .total-cell {
      font-size: 0.7rem;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <header class="admin-header">
    <div class="container-fluid header-ribbon">
      <div>
        <a href="/admin/canvases" class="text-white-50 text-decoration-none">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align: -2px;">
            <path fill="currentColor" d="M14.5 5l-7 7 7 7 1.4-1.4L10.3 12l5.6-5.6z"/>
          </svg>
          All Canvases
        </a>
      </div>
      <div class="header-title">
        <%= fileInfo.artist %> - <%= fileInfo.title %> <% if (fileInfo.year) { %>(<%= fileInfo.year %>)<% } %>
      </div>
      <div class="header-actions">
        <button id="saveBtn" class="btn btn-success btn-sm">Save</button>
        <button id="saveNextBtn" class="btn btn-success btn-sm" <%= nextUnfinishedFilename ? '' : 'disabled' %>>Save &amp; Next</button>
        <a href="/admin/canvases" class="btn btn-outline-light btn-sm">Cancel</a>
      </div>
    </div>
  </header>

  <main class="p-3">
    <div class="editor-container">
      <!-- Canvas Workspace -->
      <div class="canvas-workspace">
        <div class="toolbar">
          <button id="addModeBtn" class="active">
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align: -2px;">
              <path fill="currentColor" d="M11 5h2v14h-2zM5 11h14v2H5z"/>
            </svg>
            Add Squares
          </button>
          <button id="selectModeBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align: -2px;">
              <path fill="currentColor" d="M4 2l16 8-6.5 1.5L12 20l-3-6.5L4 2z"/>
            </svg>
            Select Mode
          </button>
          <button id="clearAllBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" style="vertical-align: -2px;">
              <path fill="currentColor" d="M9 3h6l1 2h5v2H3V5h5zM6 9h12l-1 11H7z"/>
            </svg>
            Clear All
          </button>
          <span class="text-white ms-auto small">Click on canvas to add paint squares. Drag to move.</span>
        </div>
        <div class="color-ribbon" id="addColorsRibbon">
          <span class="text-white-50 small">Allowed Colors</span>
          <label class="color-toggle red">
            <input type="checkbox" value="red" checked> Red
          </label>
          <label class="color-toggle orange">
            <input type="checkbox" value="orange"> Orange
          </label>
          <label class="color-toggle yellow">
            <input type="checkbox" value="yellow"> Yellow
          </label>
          <label class="color-toggle green">
            <input type="checkbox" value="green"> Green
          </label>
          <label class="color-toggle blue">
            <input type="checkbox" value="blue"> Blue
          </label>
          <label class="color-toggle purple">
            <input type="checkbox" value="purple"> Purple
          </label>
          <label class="color-toggle black">
            <input type="checkbox" value="black"> Black
          </label>
        </div>
        <div class="canvas-container" id="canvasContainer">
          <img 
            src="<%= fileInfo.fullPath %>" 
            alt="<%= fileInfo.title %>"
            class="canvas-image"
            id="canvasImage"
          >
          <div id="squaresOverlay"></div>
        </div>
      </div>

      <!-- Settings Panel -->
      <div class="settings-panel">
        <h5 class="mb-3">Canvas Settings</h5>
        
        <form id="canvasForm">
          <input type="hidden" name="id" value="<%= canvas ? canvas.id : '' %>">
          <input type="hidden" name="filename" value="<%= fileInfo.filename %>">
          
          <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" value="<%= canvas ? canvas.name : fileInfo.title %>" required>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Artist</label>
            <input type="text" class="form-control" name="artist" value="<%= canvas ? canvas.artist : fileInfo.artist %>">
          </div>
          
          <div class="mb-3">
            <label class="form-label">Year</label>
            <input type="text" class="form-control" name="year" value="<%= canvas ? canvas.year : fileInfo.year || '' %>">
          </div>
          
          <div class="row mb-3">
            <div class="col-4">
              <label class="form-label">Stars</label>
              <input type="number" class="form-control" name="star_value" 
                     value="<%= canvas ? canvas.star_value : defaultValues.star_value %>" min="1" max="10">
            </div>
            <div class="col-4">
              <label class="form-label">Paint</label>
              <input type="number" class="form-control" name="paint_value" 
                     value="<%= canvas ? canvas.paint_value : defaultValues.paint_value %>" min="1" max="10">
            </div>
            <div class="col-4">
              <label class="form-label">Food</label>
              <input type="number" class="form-control" name="food_value" 
                     value="<%= canvas ? canvas.food_value : defaultValues.food_value %>" min="0" max="10">
            </div>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Orientation</label>
            <select class="form-select" name="orientation">
              <option value="landscape" <%= canvas && canvas.layout_json?.orientation === 'landscape' ? 'selected' : '' %>>Landscape</option>
              <option value="portrait" <%= canvas && canvas.layout_json?.orientation === 'portrait' ? 'selected' : '' %>>Portrait</option>
            </select>
          </div>
        </form>

        <hr>
        
        <!-- Square Editor -->
        <h6 class="mb-2">Paint Squares (<span id="squareCount">0</span>)</h6>
        <p class="info-text">Click on the canvas to add squares. Select a square to edit its colors.</p>
        
        <div class="square-list mb-3" id="squareList">
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // State
    let squares = [];
    let selectedSquareIndex = -1;
    let mode = 'add'; // 'add' or 'select'
    let isDragging = false;
    let dragOffset = { x: 0, y: 0 };
    const baseSquareSize = 115;
    const colors = ['red', 'orange', 'yellow', 'green', 'blue', 'purple', 'black'];
    const colorLabels = ['R', 'O', 'Y', 'G', 'B', 'V', 'B'];
    let zoomScale = 1;
    let fitScale = 1;
    let hasManualZoom = false;
    
    // Load existing squares
    <% if (canvas && canvas.layout_json && canvas.layout_json.squares) { %>
      squares = <%- JSON.stringify(canvas.layout_json.squares) %>;
    <% } %>
    squares = squares.map(sq => ({
      ...sq,
      position: {
        x: sq.position?.x ?? sq.x ?? 0,
        y: sq.position?.y ?? sq.y ?? 0,
      },
      allowedColors: sq.allowedColors && sq.allowedColors.length ? sq.allowedColors : ['red'],
    }));
    
    // DOM elements
    const canvasContainer = document.getElementById('canvasContainer');
    const canvasImage = document.getElementById('canvasImage');
    const squaresOverlay = document.getElementById('squaresOverlay');
    const squareList = document.getElementById('squareList');
    const squareCountEl = document.getElementById('squareCount');
    const addColorsRibbon = document.getElementById('addColorsRibbon');
    const addColorInputs = Array.from(addColorsRibbon.querySelectorAll('input[type="checkbox"]'));
    const saveNextBtn = document.getElementById('saveNextBtn');
    const nextUnfinishedFilename = '<%= nextUnfinishedFilename || "" %>';
    
    function applyMode(nextMode) {
      mode = nextMode;
      const addBtn = document.getElementById('addModeBtn');
      const selectBtn = document.getElementById('selectModeBtn');
      if (mode === 'add') {
        addBtn.classList.add('active');
        selectBtn.classList.remove('active');
        canvasContainer.style.cursor = 'crosshair';
      } else {
        selectBtn.classList.add('active');
        addBtn.classList.remove('active');
        canvasContainer.style.cursor = 'default';
      }
    }

    // Mode buttons
    document.getElementById('addModeBtn').addEventListener('click', () => {
      if (addColorInputs.every(i => !i.checked)) {
        applyMode('select');
        return;
      }
      applyMode('add');
    });
    
    document.getElementById('selectModeBtn').addEventListener('click', () => {
      applyMode('select');
    });
    
    document.getElementById('clearAllBtn').addEventListener('click', () => {
      if (confirm('Remove all squares?')) {
        squares = [];
        selectedSquareIndex = -1;
        renderSquares();
      }
    });

    addColorInputs.forEach(input => {
      input.addEventListener('change', () => {
        const selected = addColorInputs.filter(i => i.checked);
        if (selected.length === 0) {
          applyMode('select');
        } else {
          applyMode('add');
        }
      });
    });
    
    // Add square on click
    canvasContainer.addEventListener('click', (e) => {
      if (mode !== 'add' || isDragging) return;
      if (e.target.classList.contains('square-overlay') || e.target.classList.contains('delete-btn')) return;
      
      const rect = canvasImage.getBoundingClientRect();
      const x = Math.round((e.clientX - rect.left) / zoomScale - baseSquareSize / 2);
      const y = Math.round((e.clientY - rect.top) / zoomScale - baseSquareSize / 2);
      const maxX = Math.max(0, canvasImage.naturalWidth - baseSquareSize);
      const maxY = Math.max(0, canvasImage.naturalHeight - baseSquareSize);
      const clampedX = Math.max(0, Math.min(x, maxX));
      const clampedY = Math.max(0, Math.min(y, maxY));
      const selectedColors = addColorInputs.filter(i => i.checked).map(i => i.value);
      if (selectedColors.length === 0) {
        applyMode('select');
        return;
      }
      
      // Create new square
      const newSquare = {
        id: `sq-${Date.now()}`,
        position: { x: clampedX, y: clampedY },
        allowedColors: selectedColors.length ? selectedColors : ['red'],
      };
      
      squares.push(newSquare);
      selectedSquareIndex = squares.length - 1;
      renderSquares();
    });
    
    // Render squares
    function renderSquares() {
      squaresOverlay.innerHTML = '';
      squareList.innerHTML = '';
      squareCountEl.textContent = squares.length;
      updateOverlaySize();

      const headerRow = document.createElement('div');
      headerRow.className = 'square-grid-header';
      headerRow.innerHTML = `
        <div class="square-label"> </div>
        ${colorLabels.map(label => `<div class="text-center">${label}</div>`).join('')}
      `;
      squareList.appendChild(headerRow);

      const colorTotals = colors.reduce((acc, color) => {
        acc[color] = 0;
        return acc;
      }, {});
      
      squares.forEach((sq, index) => {
        colors.forEach(color => {
          if (sq.allowedColors.includes(color)) colorTotals[color] += 1;
        });

        // Create overlay element
        const div = document.createElement('div');
        div.className = 'square-overlay' + (index === selectedSquareIndex ? ' selected' : '');
        div.style.left = (sq.position.x * zoomScale) + 'px';
        div.style.top = (sq.position.y * zoomScale) + 'px';
        div.style.width = (baseSquareSize * zoomScale) + 'px';
        div.style.height = (baseSquareSize * zoomScale) + 'px';
        div.textContent = index + 1;
        div.dataset.index = index;
        
        // Color preview
        const firstColor = sq.allowedColors[0] || 'red';
        div.style.borderColor = getColorHex(firstColor);
        
        // Delete button
        const deleteBtn = document.createElement('div');
        deleteBtn.className = 'delete-btn';
        deleteBtn.textContent = '??';
        deleteBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          squares.splice(index, 1);
          if (selectedSquareIndex >= squares.length) selectedSquareIndex = -1;
          renderSquares();
        });
        div.appendChild(deleteBtn);
        
        // Click to select
        div.addEventListener('click', (e) => {
          e.stopPropagation();
          selectSquare(index);
        });
        
        // Drag functionality
        div.addEventListener('mousedown', (e) => {
          if (e.target.classList.contains('delete-btn')) return;
          if (mode !== 'select') return;
          isDragging = true;
          const rect = canvasImage.getBoundingClientRect();
          dragOffset = {
            x: (e.clientX - rect.left) / zoomScale - sq.position.x,
            y: (e.clientY - rect.top) / zoomScale - sq.position.y
          };
          selectSquare(index);
        });
        
        squaresOverlay.appendChild(div);
        
        // Create list item
        const li = document.createElement('div');
        li.className = 'square-grid-row' + (index === selectedSquareIndex ? ' selected' : '');
        li.innerHTML = `
          <div class="square-label"><strong>#${index + 1}</strong> (${sq.position.x}, ${sq.position.y})</div>
          ${colors.map(color => {
            const active = sq.allowedColors.includes(color);
            return `<div class="color-cell ${color} ${active ? 'active' : ''}" data-color="${color}" data-index="${index}">${active ? '?' : ''}</div>`;
          }).join('')}
        `;
        li.addEventListener('click', () => selectSquare(index));
        squareList.appendChild(li);
      });

      const totalRow = document.createElement('div');
      totalRow.className = 'square-grid-total';
      totalRow.innerHTML = `
        <div class="square-label">Total</div>
        ${colors.map(color => {
          const count = colorTotals[color];
          const active = count > 0;
          return `<div class="color-cell total-cell ${color} ${active ? 'active' : ''}">${count || ''}</div>`;
        }).join('')}
      `;
      squareList.appendChild(totalRow);

      bindColorCellHandlers();
    }
    
    // Mouse move for dragging
    document.addEventListener('mousemove', (e) => {
      if (!isDragging || selectedSquareIndex < 0) return;
      
      const rect = canvasImage.getBoundingClientRect();
      const x = Math.round((e.clientX - rect.left) / zoomScale - dragOffset.x);
      const y = Math.round((e.clientY - rect.top) / zoomScale - dragOffset.y);
      
      // Clamp to canvas bounds
      const maxX = Math.max(0, canvasImage.naturalWidth - baseSquareSize);
      const maxY = Math.max(0, canvasImage.naturalHeight - baseSquareSize);
      squares[selectedSquareIndex].position.x = Math.max(0, Math.min(x, maxX));
      squares[selectedSquareIndex].position.y = Math.max(0, Math.min(y, maxY));
      
      renderSquares();
    });
    
    document.addEventListener('mouseup', () => {
      isDragging = false;
    });
    
    // Select square
    function selectSquare(index) {
      selectedSquareIndex = index;
      renderSquares();
    }

    function bindColorCellHandlers() {
      squareList.querySelectorAll('.color-cell[data-index]').forEach(cell => {
        cell.addEventListener('click', (e) => {
          e.stopPropagation();
          const index = parseInt(cell.dataset.index, 10);
          const color = cell.dataset.color;
          if (Number.isNaN(index) || !color) return;

          const square = squares[index];
          const hasColor = square.allowedColors.includes(color);
          if (hasColor && square.allowedColors.length === 1) return;

          if (hasColor) {
            square.allowedColors = square.allowedColors.filter(c => c !== color);
          } else {
            square.allowedColors = [...square.allowedColors, color];
          }
          selectedSquareIndex = index;
          renderSquares();
        });
      });
    }
    
    // Color helper
    function getColorHex(color) {
      const colors = {
        red: '#EF4444',
        orange: '#F97316',
        yellow: '#EAB308',
        green: '#22C55E',
        blue: '#3B82F6',
        purple: '#A855F7',
        black: '#1F2937',
      };
      return colors[color] || '#888';
    }

    function updateOverlaySize() {
      if (!canvasImage.naturalWidth || !canvasImage.naturalHeight) return;
      const displayWidth = canvasImage.naturalWidth * zoomScale;
      const displayHeight = canvasImage.naturalHeight * zoomScale;
      canvasImage.style.width = displayWidth + 'px';
      canvasImage.style.height = displayHeight + 'px';
      squaresOverlay.style.width = displayWidth + 'px';
      squaresOverlay.style.height = displayHeight + 'px';
    }

    function computeFitScale() {
      const workspace = document.querySelector('.canvas-workspace');
      const style = window.getComputedStyle(workspace);
      const paddingX = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
      const paddingY = parseFloat(style.paddingTop) + parseFloat(style.paddingBottom);
      const availableWidth = workspace.clientWidth - paddingX;
      const availableHeight = workspace.clientHeight - paddingY - 110;
      if (!canvasImage.naturalWidth || !canvasImage.naturalHeight) return 1;
      const scaleX = availableWidth / canvasImage.naturalWidth;
      const scaleY = availableHeight / canvasImage.naturalHeight;
      return Math.min(scaleX, scaleY);
    }

    function applyZoom(newScale, manual = false) {
      zoomScale = Math.max(0.2, Math.min(newScale, fitScale));
      if (manual) hasManualZoom = true;
      updateOverlaySize();
      renderSquares();
    }

    canvasContainer.addEventListener('wheel', (e) => {
      if (!e.ctrlKey) return;
      e.preventDefault();
      if (e.deltaY > 0) {
        applyZoom(zoomScale - 0.05, true);
      }
    }, { passive: false });

    window.addEventListener('resize', () => {
      fitScale = computeFitScale();
      if (!hasManualZoom) {
        applyZoom(fitScale, false);
      } else {
        zoomScale = Math.max(0.2, Math.min(zoomScale, fitScale));
        updateOverlaySize();
        renderSquares();
      }
    });
    
    async function saveCanvas(redirectToNext) {
      const form = document.getElementById('canvasForm');
      const formData = new FormData(form);
      
      const data = {
        id: formData.get('id') || null,
        filename: formData.get('filename'),
        name: formData.get('name'),
        artist: formData.get('artist'),
        year: formData.get('year'),
        star_value: formData.get('star_value'),
        paint_value: formData.get('paint_value'),
        food_value: formData.get('food_value'),
        orientation: formData.get('orientation'),
        squares: squares,
      };
      
      try {
        const response = await fetch('/admin/api/canvas', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        
        const result = await response.json();
        
        if (result.success) {
          document.querySelector('input[name="id"]').value = result.canvas.id;
          if (redirectToNext && nextUnfinishedFilename) {
            window.location.href = `/admin/canvas/edit/${encodeURIComponent(nextUnfinishedFilename)}`;
            return;
          }
          alert('Canvas saved successfully!');
        } else {
          alert('Error: ' + (result.error || 'Failed to save'));
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    }

    document.getElementById('saveBtn').addEventListener('click', () => saveCanvas(false));
    if (saveNextBtn) {
      saveNextBtn.addEventListener('click', () => saveCanvas(true));
    }

    canvasImage.addEventListener('load', () => {
      fitScale = computeFitScale();
      applyZoom(fitScale);
    });
    if (canvasImage.complete) {
      fitScale = computeFitScale();
      applyZoom(fitScale);
    }
    
    // Initial render
    renderSquares();
  </script>
</body>
</html>
