<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/themes/default.css">
  <link rel="stylesheet" href="/css/main.css">
  <style>
    .admin-header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      color: white;
      padding: 1rem 0;
    }
    .stat-card {
      background: white;
      border-radius: 12px;
      padding: 1.5rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-align: center;
    }
    .stat-number {
      font-size: 2.5rem;
      font-weight: bold;
      color: #3B82F6;
    }
    .canvas-preview {
      width: 100%;
      height: 120px;
      object-fit: cover;
      border-radius: 8px;
    }
    .canvas-card {
      border: 2px solid #e5e7eb;
      border-radius: 12px;
      overflow: hidden;
      transition: all 0.2s;
    }
    .canvas-card:hover {
      border-color: #3B82F6;
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
    }
    .status-badge {
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
    }
    .status-configured { background: #10B981; color: white; }
    .status-missing { background: #F59E0B; color: white; }
  </style>
</head>
<body>
  <header class="admin-header">
    <div class="container">
      <div class="d-flex justify-content-between align-items-center">
        <h1 class="h3 mb-0">🎨 Canvas Admin</h1>
        <a href="/" class="btn btn-outline-light btn-sm">← Back to Game</a>
      </div>
    </div>
  </header>

  <main class="py-4">
    <div class="container">
      <!-- Stats -->
      <div class="row g-4 mb-5">
        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-number"><%= stats.totalFiles %></div>
            <div class="text-muted">Total Canvas Files</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-number" style="color: #10B981;"><%= stats.filesInDb %></div>
            <div class="text-muted">Configured</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-number" style="color: #F59E0B;"><%= stats.filesMissing %></div>
            <div class="text-muted">Need Configuration</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-card">
            <div class="stat-number" style="color: #8B5CF6;"><%= stats.totalDefinitions %></div>
            <div class="text-muted">Total Definitions</div>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card mb-4">
        <div class="card-body">
          <h5 class="card-title">Quick Actions</h5>
          <div class="d-flex gap-2 flex-wrap">
            <a href="/admin/canvases" class="btn btn-primary">
              📋 View All Canvases
            </a>
            <button id="importAllBtn" class="btn btn-success">
              📥 Import All Files to Database
            </button>
            <button id="refreshBtn" class="btn btn-secondary">
              🔄 Refresh
            </button>
          </div>
        </div>
      </div>

      <!-- Canvas Preview -->
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Recent Canvas Files</h5>
          <a href="/admin/canvases" class="btn btn-sm btn-outline-primary">View All →</a>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <% canvasFiles.forEach(file => { %>
              <div class="col-md-3 col-sm-4 col-6">
                <div class="canvas-card">
                  <img 
                    src="<%= file.fullPath %>" 
                    alt="<%= file.title %>"
                    class="canvas-preview"
                    onerror="this.src='/images/placeholder.png'"
                  >
                  <div class="p-2">
                    <div class="fw-semibold small text-truncate" title="<%= file.title %>">
                      <%= file.title %>
                    </div>
                    <div class="text-muted small text-truncate">
                      <%= file.artist %>
                    </div>
                    <div class="mt-2">
                      <% if (file.inDatabase) { %>
                        <span class="status-badge status-configured">✓ Configured</span>
                      <% } else { %>
                        <span class="status-badge status-missing">⚠ Needs Setup</span>
                      <% } %>
                    </div>
                    <a href="/admin/canvas/edit/<%= encodeURIComponent(file.filename) %>" 
                       class="btn btn-sm btn-outline-primary w-100 mt-2">
                      Edit
                    </a>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Import all files
    document.getElementById('importAllBtn').addEventListener('click', async () => {
      if (!confirm('Import all canvas files to database? This will create entries for all files not already configured.')) {
        return;
      }
      
      try {
        const response = await fetch('/admin/api/canvases/import', {
          method: 'POST',
        });
        const data = await response.json();
        
        if (data.success) {
          alert(`${data.message}`);
          location.reload();
        } else {
          alert('Error: ' + (data.error || 'Import failed'));
        }
      } catch (error) {
        alert('Error: ' + error.message);
      }
    });
    
    // Refresh
    document.getElementById('refreshBtn').addEventListener('click', () => {
      location.reload();
    });
  </script>
</body>
</html>
