<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/themes/default.css">
  <link rel="stylesheet" href="/css/overrides.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/game.css">
</head>
<body>
  <!-- Header -->
  <header class="app-header">
    <div class="container-fluid">
      <a href="/" class="app-logo">SA <span>Starving Artists</span></a>
      <div class="header-game-info">
  <span class="day-indicator">Day <span id="dayNumber"><%= game.day_number %></span></span>
  <span id="headerStatus" class="header-status">Multiplayer Session</span>
</div>
    </div>
  </header>

  <!-- Waiting Overlay -->
  <div id="waitingOverlay" class="waiting-overlay <%= isCurrentTurn ? 'd-none' : '' %>" data-testid="waiting-overlay">
    <div class="waiting-content">
      <div class="waiting-spinner"></div>
      <div class="waiting-text">
        Waiting for <span id="waitingPlayerName"><%= players.find(p => p.id === game.current_player_id)?.name || 'other player' %></span>...
      </div>
    </div>
  </div>

  <!-- Selling Phase Modal -->
  <div id="sellingPhaseModal" class="selling-modal <%= game.current_phase === 'selling' ? '' : 'd-none' %>" data-testid="selling-modal">
    <div class="selling-content">
      <h3>Selling Phase</h3>
      <p class="selling-instructions">
        Players collect paint cubes based on their completed paintings.<br>
        <strong>Highest Paint Value:</strong> 4 cubes per turn<br>
        <strong>Second Highest:</strong> 2 cubes per turn<br>
        <strong>Others:</strong> 1 cube per turn
      </p>
      
      <div id="sellingOrder" class="selling-order">
        <!-- Populated by JS -->
      </div>
      
      <div id="sellingMarket" class="selling-market">
        <h5>Select Paint Cubes (<span id="sellingMaxCubes">0</span> max)</h5>
        <div id="sellingPaintCubes" class="paint-cubes-selectable">
          <!-- Populated by JS -->
        </div>
        <div class="selected-cubes-info mt-2">
          Selected: <span id="selectedCubeCount">0</span> cubes
        </div>
      </div>
      
      <div class="selling-actions mt-3">
        <button id="collectPaintBtn" class="btn btn-primary" disabled data-testid="collect-paint-btn">
          Collect Selected Cubes
        </button>
        <button id="skipCollectionBtn" class="btn btn-secondary" data-testid="skip-collection-btn">
          Skip (Pass)
        </button>
      </div>
    </div>
  </div>

  <main class="game-container">
  <div class="container-fluid">
    <div class="game-board">
      <section class="shared-space" data-testid="shared-space">
        <div class="shared-top">
          <div class="canvas-market-block" data-testid="canvas-market-section">
            <div class="section-label">Canvas Market</div>
            <div id="canvasMarket" class="canvas-market-row">
              <% const costs = [1, 2, 3]; %>
              <% gameState.canvas_market.forEach((canvas, index) => { %>
                <% if (canvas) { %>
                  <div class="market-canvas-card" tabindex="0" aria-label="Canvas <%= canvas.name %>" data-slot-index="<%= index %>" data-testid="market-canvas-<%= index %>">
                    <div class="canvas-cost">Cost <%= costs[index] %></div>
                    <% if (canvas.filename) { %>
                      <div class="market-canvas-media">
                        <img src="/assets/canvases/<%= canvas.filename %>" alt="<%= canvas.name %>" class="canvas-thumbnail">
                        <% if (canvas.layout_json && canvas.layout_json.squares) { %>
                          <div class="canvas-squares-overlay preview">
                            <% canvas.layout_json.squares.forEach(square => { %>
                              <div 
                                class="canvas-square-marker" 
                                style="left: <%= (square.position?.x || 0) / 3 %>px; top: <%= (square.position?.y || 0) / 3 %>px;"
                                data-allowed-colors="<%= square.allowedColors.join(',') %>"
                                title="<%= square.allowedColors.join(', ') %>"
                              ></div>
                            <% }); %>
                          </div>
                        <% } %>
                      </div>
                    <% } else if (canvas.layout_json && canvas.layout_json.squares) { %>
                      <div class="market-canvas-media">
                        <div class="canvas-grid canvas-preview">
                          <% 
                            const squares = canvas.layout_json.squares;
                            const maxX = Math.max(...squares.map(s => s.position?.x || s.x || 0));
                            const maxY = Math.max(...squares.map(s => s.position?.y || s.y || 0));
                            const cols = Math.ceil((maxX + 40) / 44);
                          %>
                          <div style="display: grid; grid-template-columns: repeat(<%= cols %>, 24px); gap: 2px;">
                            <% squares.forEach(square => { %>
                              <div 
                                class="canvas-square preview-square" 
                                style="background: linear-gradient(135deg, <%= getColorStyle(square.allowedColors[0]) %>);"
                                data-allowed-colors="<%= square.allowedColors.join(',') %>"
                                title="<%= square.allowedColors.join(', ') %>"
                              ></div>
                            <% }); %>
                          </div>
                        </div>
                      </div>
                    <% } %>
                    <div class="canvas-hover-meta">
                      Stars <%= canvas.star_value %> ? Paint <%= canvas.paint_value %> ? Food <%= canvas.food_value %>
                    </div>
                  </div>
                <% } else { %>
                  <div class="market-canvas-card empty" data-testid="market-canvas-empty-<%= index %>">
                    <div class="text-muted">Empty Slot</div>
                  </div>
                <% } %>
              <% }); %>
            </div>
          </div>

          <div class="canvas-deck-block" data-testid="canvas-deck">
            <div class="deck-stack" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="deck-label">Canvas Draw Deck</div>
            <div class="deck-count"><span id="canvasDeckCount"><%= gameState.canvas_deck?.length || 0 %></span> cards</div>
          </div>

          <div class="status-cluster" data-testid="status-cluster">
            <div id="phaseIndicator" class="phase-indicator" data-phase="<%= game.current_phase %>">
              <div class="phase-icon">
                <svg class="phase-svg phase-morning" viewBox="0 0 64 64" role="img" aria-label="Morning">
                  <circle cx="32" cy="32" r="14"></circle>
                  <g class="rays">
                    <line x1="32" y1="4" x2="32" y2="14"></line>
                    <line x1="32" y1="50" x2="32" y2="60"></line>
                    <line x1="4" y1="32" x2="14" y2="32"></line>
                    <line x1="50" y1="32" x2="60" y2="32"></line>
                    <line x1="12" y1="12" x2="19" y2="19"></line>
                    <line x1="45" y1="45" x2="52" y2="52"></line>
                    <line x1="12" y1="52" x2="19" y2="45"></line>
                    <line x1="45" y1="19" x2="52" y2="12"></line>
                  </g>
                </svg>
                <svg class="phase-svg phase-day" viewBox="0 0 64 64" role="img" aria-label="Afternoon">
                  <circle cx="24" cy="28" r="10"></circle>
                  <path d="M36 44c0-8 8-14 16-14h6v14H36z"></path>
                </svg>
                <svg class="phase-svg phase-night" viewBox="0 0 64 64" role="img" aria-label="Evening">
                  <path d="M40 10a18 18 0 1 0 14 30A20 20 0 1 1 40 10z"></path>
                </svg>
              </div>
              <div id="phaseLabel" class="phase-label"><%= game.current_phase === 'morning' ? 'Morning' : game.current_phase === 'day' ? 'Afternoon' : game.current_phase === 'night' ? 'Evening' : 'Selling' %></div>
            </div>
            <div id="playerOrderTracker" class="player-order-tracker"></div>
          </div>
        </div>

        <div class="paint-market-block" data-testid="paint-market-section">
          <div class="section-label">Paint Market</div>
          <div id="paintMarket" class="paint-market-rail">
            <% 
              const colorOrder = ['red', 'orange', 'yellow', 'green', 'blue', 'purple', 'black', 'wild'];
              const marketGroups = {};
              colorOrder.forEach(color => { marketGroups[color] = []; });
              gameState.paint_market.forEach(cube => { marketGroups[cube.color].push(cube); });
            %>
            <% colorOrder.forEach(color => { %>
              <div class="paint-slot" data-color="<%= color %>">
                <div class="paint-slot-header">
                  <span class="color-label"><%= color.slice(0, 1).toUpperCase() %></span>
                  <span class="slot-count"><%= marketGroups[color].length %></span>
                </div>
                <div class="paint-slot-cubes">
                  <% marketGroups[color].forEach(cube => { %>
                    <div 
                      class="paint-cube in-market" 
                      data-cube-id="<%= cube.id %>"
                      data-color="<%= cube.color %>"
                      data-is-wild="<%= cube.is_wild %>"
                      title="<%= cube.color %><%= cube.is_wild ? ' (Wild)' : '' %>"
                    ></div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section class="action-bar" data-testid="action-bar">
        <div class="action-buttons">
          <button id="actionPaintBtn" class="btn action-btn" data-action="paint" data-testid="paint-btn" <%= !isCurrentTurn || game.current_phase === 'selling' ? 'disabled' : '' %>>Paint</button>
          <button id="actionWorkBtn" class="btn action-btn" data-action="work" data-testid="work-btn" <%= !isCurrentTurn || game.current_phase === 'selling' ? 'disabled' : '' %>>Work</button>
          <button id="actionBuyBtn" class="btn action-btn" data-action="buy" data-testid="buy-btn" <%= !isCurrentTurn || game.current_phase === 'selling' ? 'disabled' : '' %>>Buy</button>
          <button id="actionPassBtn" class="btn action-btn" data-action="pass" data-testid="pass-btn" <%= !isCurrentTurn || game.current_phase === 'selling' ? 'disabled' : '' %>>Pass</button>
          <button id="actionSellBtn" class="btn action-btn" data-action="sell" data-testid="sell-btn" <%= !isCurrentTurn || game.current_phase !== 'night' ? 'disabled' : '' %>>Sell</button>
          <div class="action-dropdown">
            <button id="actionFreeBtn" class="btn action-btn" data-action="free" data-testid="free-btn">Free</button>
            <div id="freeActionMenu" class="dropdown-menu">
              <button class="dropdown-item" data-free-action="trade" disabled>Trade</button>
              <button class="dropdown-item" data-free-action="reset-market" disabled>Reset Market</button>
            </div>
          </div>
        </div>
        <div class="action-meta">
          <span id="turnStatus" class="turn-status"><%= isCurrentTurn ? "Your turn" : "Waiting for " + (players.find(p => p.id === game.current_player_id)?.name || "player") %></span>
          <div class="pending-paints">
            <span>Pending: <strong id="pendingPaintsCount">0</strong></span>
            <button id="commitPaintsBtn" class="btn btn-sm btn-accent" disabled data-testid="commit-paints-btn">Apply Paints</button>
          </div>
        </div>
      </section>

      <section class="player-space" data-testid="player-space">
        <div class="player-space-header">
          <div class="player-identity">
            <div class="player-name"><%= currentPlayer.name %></div>
            <div class="player-stats">
              <span>Score <strong id="playerScore"><%= currentPlayer.score %></strong></span>
              <span>Nutrition <strong id="nutritionValue"><%= currentPlayer.nutrition %></strong></span>
            </div>
          </div>
        </div>

        <div id="canvasPurchasePanel" class="purchase-panel d-none" data-testid="canvas-purchase-panel">
          <div class="purchase-header">
            <div>
              <div class="purchase-title">Buy Canvas</div>
              <div class="purchase-subtitle" id="purchaseCanvasName">Select a canvas to buy</div>
            </div>
            <button id="cancelPurchaseBtn" class="btn btn-sm btn-secondary" type="button">Cancel</button>
          </div>
          <div class="purchase-body">
            <div class="purchase-cost">Cost: <span id="purchaseCost">0</span> cube(s)</div>
            <div class="purchase-instructions">Select cubes to pay for this canvas.</div>
            <div id="purchaseCubePool" class="paint-cubes-selectable purchase-cubes"></div>
            <div class="selected-cubes-info mt-2">
              Selected: <span id="purchaseSelectedCount">0</span> cube(s)
            </div>
          </div>
          <div class="purchase-actions mt-3">
            <button id="confirmPurchaseBtn" class="btn btn-primary" type="button" disabled>Confirm Purchase</button>
          </div>
        </div>

        <div id="sellSelectionPanel" class="sell-selection d-none" data-testid="sell-selection-panel">
          <div class="sell-selection-header">
            <div class="sell-title">Select completed canvases to sell</div>
            <button id="cancelSellBtn" class="btn btn-sm btn-secondary" type="button">Cancel</button>
          </div>
          <div id="sellSelectionList" class="sell-selection-list"></div>
          <div class="sell-selection-actions">
            <button id="confirmSellBtn" class="btn btn-primary" type="button" disabled>Submit Sell</button>
          </div>
        </div>

        <div class="canvas-carousel">
          <button id="canvasPrevBtn" class="carousel-nav" type="button" aria-label="Previous canvas">&lsaquo;</button>
          <div id="playerCanvases" class="canvas-carousel-track">
            <% if (playerCanvases.length > 0) { %>
              <% playerCanvases.forEach((canvas, index) => { %>
                <div class="canvas-card <%= canvas.completed ? 'completed' : '' %>" data-canvas-id="<%= canvas.id %>" data-testid="player-canvas-<%= canvas.id %>">
                  <% if (canvas.definition && canvas.definition.filename) { %>
                    <div class="canvas-painting-container" data-orientation="<%= canvas.definition.layout_json?.orientation || 'landscape' %>">
                      <img src="/assets/canvases/<%= canvas.definition.filename %>" alt="<%= canvas.definition.name %>" class="canvas-painting-img">
                      <% if (canvas.definition.layout_json && canvas.definition.layout_json.squares) { %>
                        <div class="canvas-paint-overlay">
                          <% 
                            const paintedMap = new Map(canvas.painted_squares.map(ps => [ps.squareId, ps]));
                          %>
                          <% canvas.definition.layout_json.squares.forEach(square => { %>
                            <% const painted = paintedMap.get(square.id); %>
                              <div 
                                class="paint-drop-zone <%= painted ? 'painted' : 'drop-zone' %>" 
                                data-square-id="<%= square.id %>"
                                data-allowed-colors="<%= square.allowedColors.join(',') %>"
                                data-x="<%= square.position?.x || 0 %>"
                                data-y="<%= square.position?.y || 0 %>"
                                style="<%= painted ? 'background-color: var(--paint-' + painted.color + ');' : '' %>"
                                <%= painted ? 'data-cube-color="' + painted.color + '"' : '' %>
                                title="<%= painted ? 'Painted: ' + painted.color : 'Allowed: ' + square.allowedColors.join(', ') %>"
                              >
                              <% if (painted) { %><span class="paint-check">&#10003;</span><% } %>
                            </div>
                          <% }); %>
                        </div>
                      <% } %>
                    </div>
                  <% } else if (canvas.definition && canvas.definition.layout_json && canvas.definition.layout_json.squares) { %>
                    <% 
                      const squares = canvas.definition.layout_json.squares;
                      const paintedMap = new Map(canvas.painted_squares.map(ps => [ps.squareId, ps]));
                      const maxX = Math.max(...squares.map(s => s.position?.x || s.x || 0));
                      const cols = Math.ceil((maxX + 40) / 44);
                    %>
                    <div class="canvas-grid" style="grid-template-columns: repeat(<%= cols %>, 40px);">
                      <% squares.forEach(square => { %>
                        <% const painted = paintedMap.get(square.id); %>
                        <div 
                          class="canvas-square <%= painted ? 'painted' : 'drop-zone' %>" 
                          data-square-id="<%= square.id %>"
                          data-allowed-colors="<%= square.allowedColors.join(',') %>"
                          style="<%= painted ? 'background-color: var(--paint-' + painted.color + ');' : '' %>"
                          title="<%= painted ? 'Painted: ' + painted.color : 'Allowed: ' + square.allowedColors.join(', ') %>"
                        >
                          <% if (painted) { %><span style="color: white; font-size: 16px;">&#10003;</span><% } %>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                  <div class="canvas-caption">
                    <span class="canvas-title"><%= canvas.definition?.name || 'Canvas' %></span>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="text-muted text-center py-4">No canvases yet. Buy one from the market!</div>
            <% } %>
          </div>
          <button id="canvasNextBtn" class="carousel-nav" type="button" aria-label="Next canvas">&rsaquo;</button>
        </div>

        <div class="paint-tray-block">
          <div class="section-label">Your Paint</div>
          <div id="playerCubes" class="paint-tray">
            <% 
              const playerGroups = {};
              colorOrder.forEach(color => { playerGroups[color] = []; });
              playerPaintCubes.forEach(cube => { playerGroups[cube.color].push(cube); });
            %>
            <% colorOrder.forEach(color => { %>
              <div class="paint-slot" data-color="<%= color %>">
                <div class="paint-slot-header">
                  <span class="color-label"><%= color.slice(0, 1).toUpperCase() %></span>
                  <span class="slot-count"><%= playerGroups[color].length %></span>
                </div>
                <div class="paint-slot-cubes">
                  <% playerGroups[color].forEach(cube => { %>
                    <div 
                      class="paint-cube in-tray" 
                      draggable="true"
                      data-cube-id="<%= cube.id %>"
                      data-color="<%= cube.color %>"
                      data-is-wild="<%= cube.is_wild %>"
                      title="<%= cube.color %><%= cube.is_wild ? ' (Wild)' : '' %>"
                    ></div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>

  <!-- Toast Container -->
  <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  
  <!-- Utilities -->
  <script src="/js/utils/dom-helpers.js"></script>
  <script src="/js/utils/ui-helpers.js"></script>
  
  <!-- Core -->
  <script src="/js/core/api-client.js"></script>
  <script src="/js/core/socket-client.js"></script>
  
  <!-- Game Scripts -->
  <script src="/js/game/game-ui.js"></script>
  <script src="/js/game/actions.js"></script>
  <script src="/js/game/drag-drop.js"></script>
  
  <script>
    // Game configuration from server
    const gameId = '<%= game.id %>';
    const playerId = '<%= currentPlayer.id %>';
    window.gameId = gameId;
    window.playerId = playerId;
    let isCurrentTurn = <%= isCurrentTurn %>;
    
    // Initial game state
    const initialGameState = {
      game: <%- JSON.stringify(game) %>,
      players: <%- JSON.stringify(players) %>,
      gameState: <%- JSON.stringify(gameState) %>,
      playerCanvases: <%- JSON.stringify(allPlayerCanvases) %>,
      playerPaintCubes: {
        '<%= currentPlayer.id %>': <%- JSON.stringify(playerPaintCubes) %>
      }
    };

    // Global references
    let socket;
    let gameUI;
    let gameActions;
    let selectedSellingCubes = [];
    let pendingPurchase = null;
    let selectedPurchaseCubeIds = [];

    // Initialize game
    document.addEventListener('DOMContentLoaded', () => {
      initializeGame();
    });

    function initializeGame() {
      console.log('Initializing game...', { gameId, playerId });
      
      // Initialize UI manager
      gameUI = new GameUI(initialGameState);
      gameUI.setMyPlayerId(playerId);
      window.gameUI = gameUI;
      
      // Initialize actions handler
      gameActions = new GameActions(gameId, playerId);
      window.gameActions = gameActions;
      
      // Initialize Socket.IO
      socket = io({
        path: '/socket.io',
        reconnection: true,
        reconnectionDelay: 1000,
        reconnectionAttempts: 5
      });
      window.socket = socket;
      
      // Setup socket handlers
      setupSocketHandlers();
      
      // Setup action button handlers
      setupActionButtons();
      
      // Setup canvas market click handlers
      setupMarketHandlers();
      
      // Setup selling phase handlers
      setupSellingPhaseHandlers();
      
      // Initialize drag and drop
      if (window.dragDropManager) {
        window.dragDropManager.initialize();
      }

      if (gameUI) {
        gameUI.refreshCanvasOverlays();
      }
      
      // Update waiting overlay
      updateWaitingOverlay();
      
      console.log('Game initialized successfully');
    }

    function applyGameState(newState) {
      isCurrentTurn = newState.game.current_player_id === playerId;
      
      if (gameUI) {
        gameUI.updateGameState(newState);
      } else {
        updatePhaseIndicator(newState.game.current_phase);
        updateTurnIndicator(newState);
      }
      
      updateWaitingOverlay();
      updateDayNumber(newState.game.day_number);

      if (!isCurrentTurn || newState.game.current_phase === 'selling') {
        closeCanvasPurchase();
      } else if (pendingPurchase) {
        const canvas = newState.gameState.canvas_market[pendingPurchase.slotIndex];
        if (!canvas) {
          closeCanvasPurchase();
        } else {
          const cubes = newState.playerPaintCubes?.[playerId] || [];
          const cubeIdSet = new Set(cubes.map(c => c.id));
          selectedPurchaseCubeIds = selectedPurchaseCubeIds.filter(id => cubeIdSet.has(id));
          pendingPurchase.canvasName = canvas.name;
          renderPurchasePanel();
        }
      }
      
      if (newState.game.current_phase === 'selling') {
        showSellingPhase(newState);
      } else {
        hideSellingPhase();
      }

      if (newState.game.current_phase !== 'night') {
        closeSellSelection();
      }
      
      if (window.dragDropManager) {
        setTimeout(() => window.dragDropManager.refresh(), 100);
      }
    }

    window.applyGameState = applyGameState;

    function setupSocketHandlers() {
      socket.on('connect', () => {
        console.log('Connected to server');
        showToast('Connected', 'Real-time updates enabled', 'success', 2000);
        socket.emit('join-game', { gameId, playerId });
      });

      socket.on('disconnect', () => {
        console.log('Disconnected from server');
        showToast('Disconnected', 'Attempting to reconnect...', 'warning');
      });

      socket.on('game-state', (newState) => {
        console.log('Game state updated:', newState);
        applyGameState(newState);
      });

      socket.on('action-performed', (data) => {
        console.log('Action performed:', data);
        
        if (data.playerId !== playerId) {
          const playerName = getPlayerName(data.playerId);
          const messages = {
            work: `drew paint cubes`,
            'buy-canvas': `bought a canvas`,
            paint: `painted ${data.paintingsCount || 'some'} square(s)`,
            'end-turn': `ended their turn`,
            'collect-paint': `collected ${data.cubesCollected || 'some'} paint cubes`,
            'skip-collection': `passed on collecting`
          };
          showToast('Player Action', `${playerName} ${messages[data.action] || 'performed an action'}`, 'info', 3000);
        }
        
        // Handle completions
        if (data.completions && data.completions.length > 0) {
          data.completions.forEach(completion => {
            showToast('Painting Complete!', 
              `${getPlayerName(data.playerId)} completed a painting! +${completion.rewards.stars} stars`, 
              'success', 5000);
          });
        }
      });

      socket.on('turn-changed', (data) => {
        console.log('Turn changed:', data);
        isCurrentTurn = data.currentPlayerId === playerId;
        
        if (isCurrentTurn) {
          showToast('Your Turn!', "It's your turn to act", 'success');
          document.body.classList.add('bounce');
          setTimeout(() => document.body.classList.remove('bounce'), 500);
        }
        
        updateTurnIndicator({ game: { current_player_id: data.currentPlayerId } });
        updateWaitingOverlay();
        updateActionButtons();
      });

      socket.on('phase-changed', (data) => {
        console.log('Phase changed:', data);
        
        if (data.newPhase === 'selling') {
          showToast('Selling Phase', 'Collect paint cubes for completed paintings!', 'info');
        } else if (data.newPhase === 'morning' && data.newDay) {
          showToast(`Day ${data.newDay}`, 'A new day begins!', 'info');
          
          if (data.nutritionChanges) {
            const myChange = data.nutritionChanges.find(c => c.playerId === playerId);
            if (myChange) {
              showToast('Nutrition', `Your nutrition is now ${myChange.newNutrition}`, 'warning');
            }
          }
        }
        
        if (data.eliminatedPlayers && data.eliminatedPlayers.length > 0) {
          data.eliminatedPlayers.forEach(p => {
            showToast('Player Eliminated', `${p.name} has starved!`, 'danger');
          });
        }
      });

      socket.on('selling-complete', () => {
        console.log('Selling phase complete');
        hideSellingPhase();
      });

      socket.on('game-ended', (data) => {
        console.log('Game ended:', data);
        showWinModal(data.winner, data.finalScores);
      });

      socket.on('player-connected', (data) => {
        console.log('Player connected:', data.playerId);
      });

      socket.on('player-disconnected', (data) => {
        console.log('Player disconnected:', data.playerId);
        showToast('Player Disconnected', getPlayerName(data.playerId) + ' disconnected', 'warning');
      });

      socket.on('action-error', (data) => {
        console.error('Action error:', data);
        showToast('Action Failed', data.message, 'danger');
      });

      setInterval(() => {
        if (socket.connected) socket.emit('ping');
      }, 30000);
    }

    let activeAction = null;
    let selectedSellCanvasIds = [];

    function setActiveAction(action) {
      activeAction = action;
      document.querySelectorAll('.action-btn').forEach(btn => {
        if (btn.dataset.action === action) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }

    function setupActionButtons() {
      document.getElementById('actionWorkBtn')?.addEventListener('click', () => {
        setActiveAction('work');
        if (gameActions) gameActions.performWork();
      });

      document.getElementById('actionPassBtn')?.addEventListener('click', () => {
        setActiveAction('pass');
        if (gameActions) gameActions.endTurn();
      });

      document.getElementById('actionPaintBtn')?.addEventListener('click', () => {
        setActiveAction('paint');
      });

      document.getElementById('actionBuyBtn')?.addEventListener('click', () => {
        setActiveAction('buy');
        document.getElementById('canvasMarket')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });

      document.getElementById('actionSellBtn')?.addEventListener('click', () => {
        setActiveAction('sell');
        toggleSellSelection();
      });

      document.getElementById('commitPaintsBtn')?.addEventListener('click', () => {
        if (window.dragDropManager) window.dragDropManager.commitPaints();
      });

      document.getElementById('cancelSellBtn')?.addEventListener('click', () => {
        closeSellSelection();
      });

      document.getElementById('confirmSellBtn')?.addEventListener('click', () => {
        submitSellSelection();
      });
    }

    function setupMarketHandlers() {
      document.getElementById('canvasMarket')?.addEventListener('click', (e) => {
        const card = e.target.closest('.market-canvas-card:not(.empty)');
        if (card) {
          const slotIndex = parseInt(card.dataset.slotIndex);
          openCanvasPurchase(slotIndex);
        }
      });
    }

    function setupSellingPhaseHandlers() {
      // Collect paint button
      document.getElementById('collectPaintBtn')?.addEventListener('click', async () => {
        if (selectedSellingCubes.length === 0) return;
        
        try {
          const response = await fetch(`/game/${gameId}/action/collect-paint`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ cubeIds: selectedSellingCubes })
          });
          const data = await response.json();
          
          if (data.success) {
            showToast('Success', `Collected ${data.cubesCollected.length} paint cubes!`, 'success');
            selectedSellingCubes = [];
            updateSellingCubesUI();
          } else {
            showToast('Error', data.error, 'danger');
          }
        } catch (error) {
          showToast('Error', error.message, 'danger');
        }
      });

      // Skip collection button
      document.getElementById('skipCollectionBtn')?.addEventListener('click', async () => {
        try {
          const response = await fetch(`/game/${gameId}/action/skip-collection`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });
          const data = await response.json();
          
          if (data.success) {
            showToast('Skipped', 'You passed on collecting', 'info');
          } else {
            showToast('Error', data.error, 'danger');
          }
        } catch (error) {
          showToast('Error', error.message, 'danger');
        }
      });
    }

    function openCanvasPurchase(slotIndex) {
      if (!isCurrentTurn) {
        showToast('Not Your Turn', 'Wait for your turn to buy canvases', 'warning');
        return;
      }

      const canvas = gameUI?.gameState?.gameState?.canvas_market[slotIndex];
      if (!canvas) {
        showToast('Empty Slot', 'No canvas in this slot', 'warning');
        return;
      }

      const cost = [1, 2, 3][slotIndex];
      const cubes = gameUI?.gameState?.playerPaintCubes?.[playerId] || [];
      if (cubes.length < cost) {
        showToast('Not Enough Cubes', `You need ${cost} paint cube(s) to buy this canvas`, 'warning');
        return;
      }
      pendingPurchase = {
        slotIndex,
        canvasName: canvas.name,
        cost
      };
      selectedPurchaseCubeIds = [];
      renderPurchasePanel();
    }

    window.openCanvasPurchase = openCanvasPurchase;

    function closeCanvasPurchase() {
      pendingPurchase = null;
      selectedPurchaseCubeIds = [];
      const panel = document.getElementById('canvasPurchasePanel');
      if (panel) panel.classList.add('d-none');
    }

    function renderPurchasePanel() {
      const panel = document.getElementById('canvasPurchasePanel');
      if (!panel || !pendingPurchase) return;

      panel.classList.remove('d-none');
      const nameEl = document.getElementById('purchaseCanvasName');
      const costEl = document.getElementById('purchaseCost');
      if (nameEl) nameEl.textContent = pendingPurchase.canvasName;
      if (costEl) costEl.textContent = pendingPurchase.cost;

      updatePurchaseCubePool();
      updatePurchaseActions();
    }

    function updatePurchaseCubePool() {
      const pool = document.getElementById('purchaseCubePool');
      if (!pool) return;

      const cubes = gameUI?.gameState?.playerPaintCubes?.[playerId] || [];
      if (cubes.length === 0) {
        pool.innerHTML = '<div class="text-muted text-center w-100 py-2">No cubes available</div>';
        return;
      }

      const cost = pendingPurchase?.cost || 0;
      pool.innerHTML = cubes.map(cube => `
        <div 
          class="paint-cube selectable ${selectedPurchaseCubeIds.includes(cube.id) ? 'selected' : ''} ${selectedPurchaseCubeIds.length >= cost && !selectedPurchaseCubeIds.includes(cube.id) ? 'disabled' : ''}"
          data-cube-id="${cube.id}"
          data-color="${cube.color}"
          data-is-wild="${cube.is_wild}"
          title="${cube.color}${cube.is_wild ? ' (Wild)' : ''}"
        ></div>
      `).join('');

      pool.querySelectorAll('.paint-cube.selectable').forEach(el => {
        el.addEventListener('click', () => {
          togglePurchaseCube(el.dataset.cubeId);
        });
      });
    }

    function togglePurchaseCube(cubeId) {
      if (!pendingPurchase) return;
      const cost = pendingPurchase.cost;
      const index = selectedPurchaseCubeIds.indexOf(cubeId);
      if (index >= 0) {
        selectedPurchaseCubeIds.splice(index, 1);
      } else if (selectedPurchaseCubeIds.length < cost) {
        selectedPurchaseCubeIds.push(cubeId);
      }
      updatePurchaseCubePool();
      updatePurchaseActions();
    }

    function updatePurchaseActions() {
      const countEl = document.getElementById('purchaseSelectedCount');
      const confirmBtn = document.getElementById('confirmPurchaseBtn');
      const selectedCount = selectedPurchaseCubeIds.length;
      const cost = pendingPurchase?.cost || 0;

      if (countEl) countEl.textContent = selectedCount;
      if (confirmBtn) confirmBtn.disabled = !pendingPurchase || selectedCount !== cost;
    }

    document.getElementById('cancelPurchaseBtn')?.addEventListener('click', () => {
      closeCanvasPurchase();
    });

    document.getElementById('confirmPurchaseBtn')?.addEventListener('click', async () => {
      if (!pendingPurchase) return;
      const cost = pendingPurchase.cost;
      if (selectedPurchaseCubeIds.length !== cost) return;
      if (gameActions) {
        await gameActions.buyCanvas(pendingPurchase.slotIndex, selectedPurchaseCubeIds);
      }
      closeCanvasPurchase();
    });

    function toggleSellSelection() {
      const panel = document.getElementById('sellSelectionPanel');
      if (!panel) return;
      if (panel.classList.contains('d-none')) {
        openSellSelection();
      } else {
        closeSellSelection();
      }
    }

    function openSellSelection() {
      const phase = gameUI?.gameState?.game?.current_phase || initialGameState.game.current_phase;
      if (phase !== 'night') {
        showToast('Not Available', 'Sell selections are only available at night', 'warning');
        return;
      }

      const canvases = gameUI?.gameState?.playerCanvases?.[playerId] || [];
      const completed = canvases.filter(c => c.completed);
      if (completed.length === 0) {
        showToast('No Completed Canvases', 'Finish a canvas before selling', 'info');
        return;
      }

      selectedSellCanvasIds = [];
      renderSellSelection(completed);

      const panel = document.getElementById('sellSelectionPanel');
      if (panel) panel.classList.remove('d-none');
    }

    function closeSellSelection() {
      selectedSellCanvasIds = [];
      const panel = document.getElementById('sellSelectionPanel');
      if (panel) panel.classList.add('d-none');
      updateSellConfirm();
    }

    function renderSellSelection(completedCanvases) {
      const list = document.getElementById('sellSelectionList');
      if (!list) return;

      list.innerHTML = completedCanvases.map(canvas => `
        <button class="sell-selection-item" type="button" data-canvas-id="${canvas.id}">
          ${canvas.definition?.name || 'Canvas'}
        </button>
      `).join('');

      list.querySelectorAll('.sell-selection-item').forEach(item => {
        item.addEventListener('click', () => {
          const canvasId = item.dataset.canvasId;
          if (!canvasId) return;
          if (selectedSellCanvasIds.includes(canvasId)) {
            selectedSellCanvasIds = selectedSellCanvasIds.filter(id => id !== canvasId);
            item.classList.remove('selected');
          } else {
            selectedSellCanvasIds.push(canvasId);
            item.classList.add('selected');
          }
          updateSellConfirm();
        });
      });
      updateSellConfirm();
    }

    function updateSellConfirm() {
      const confirmBtn = document.getElementById('confirmSellBtn');
      if (confirmBtn) confirmBtn.disabled = selectedSellCanvasIds.length === 0;
    }

    async function submitSellSelection() {
      if (selectedSellCanvasIds.length === 0) return;
      if (gameActions) {
        await gameActions.submitSellIntents(selectedSellCanvasIds);
      }
      closeSellSelection();
    }

    function updatePhaseIndicator(phase) {
      const indicator = document.getElementById('phaseIndicator');
      const label = document.getElementById('phaseLabel');
      if (!indicator) return;

      indicator.setAttribute('data-phase', phase);
      const phaseText = {
        morning: 'Morning',
        day: 'Afternoon',
        night: 'Evening',
        selling: 'Selling'
      };
      if (label) label.textContent = phaseText[phase] || phase;
    }

    function updateTurnIndicator(state) {
      const indicator = document.getElementById('turnStatus');
      if (!indicator) return;

      if (isCurrentTurn) {
        indicator.textContent = 'Your turn';
      } else {
        indicator.textContent = `Waiting for ${getPlayerName(state.game.current_player_id)}`;
      }
    }

    function updateWaitingOverlay() {
      const overlay = document.getElementById('waitingOverlay');
      const waitingName = document.getElementById('waitingPlayerName');
      
      if (!overlay) return;
      
      const currentPhase = gameUI?.gameState?.game?.current_phase || initialGameState.game.current_phase;
      const myTurn = gameUI ? gameUI.isMyTurn() : isCurrentTurn;
      
      if (myTurn || currentPhase === 'selling') {
        overlay.classList.add('d-none');
      } else {
        overlay.classList.remove('d-none');
        const currentPlayerId = gameUI?.gameState?.game?.current_player_id || initialGameState.game.current_player_id;
        if (waitingName) {
          waitingName.textContent = getPlayerName(currentPlayerId);
        }
      }
    }

    function updateDayNumber(day) {
      const el = document.getElementById('dayNumber');
      if (el) el.textContent = day;
    }

    function updateActionButtons() {
      const workBtn = document.getElementById('actionWorkBtn');
      const passBtn = document.getElementById('actionPassBtn');
      const buyBtn = document.getElementById('actionBuyBtn');
      const paintBtn = document.getElementById('actionPaintBtn');
      const sellBtn = document.getElementById('actionSellBtn');
      const phase = gameUI?.gameState?.game?.current_phase || initialGameState.game.current_phase;

      const disabled = !isCurrentTurn || phase === 'selling';

      if (workBtn) workBtn.disabled = disabled;
      if (passBtn) passBtn.disabled = disabled;
      if (buyBtn) buyBtn.disabled = disabled;
      if (paintBtn) paintBtn.disabled = disabled;
      if (sellBtn) sellBtn.disabled = !isCurrentTurn || phase !== 'night';
    }

    function showSellingPhase(state) {
      const modal = document.getElementById('sellingPhaseModal');
      if (!modal) return;
      
      modal.classList.remove('d-none');
      
      // Update selling order display
      const sellingData = state.gameState.selling_phase_data;
      if (sellingData) {
        updateSellingOrder(sellingData, state.players);
        updateSellingMarket(state.gameState.paint_market, sellingData);
      }
    }

    function hideSellingPhase() {
      const modal = document.getElementById('sellingPhaseModal');
      if (modal) modal.classList.add('d-none');
      selectedSellingCubes = [];
    }

    function updateSellingOrder(sellingData, players) {
      const container = document.getElementById('sellingOrder');
      if (!container) return;
      
      let html = '<div class="selling-order-list">';
      sellingData.order.forEach((entry, index) => {
        const player = players.find(p => p.id === entry.playerId);
        const isActive = index === sellingData.currentIndex;
        const isDone = index < sellingData.currentIndex || entry.remainingCubes <= 0;
        
        html += `
          <div class="selling-order-item ${isActive ? 'active' : ''} ${isDone ? 'done' : ''}">
            <span class="rank-badge rank-${entry.rank}">${entry.rank === 'first' ? '1st' : entry.rank === 'second' ? '2nd' : '3rd'}</span>
            <span class="player-name">${player?.name || 'Unknown'} ${entry.playerId === playerId ? '(You)' : ''}</span>
            <span class="cubes-info">${entry.cubesPerAction}/turn, ${entry.remainingCubes} left</span>
            ${isDone ? '<span class="done-badge">Done</span>' : ''}
          </div>
        `;
      });
      html += '</div>';
      container.innerHTML = html;
    }

    function updateSellingMarket(paintMarket, sellingData) {
      const container = document.getElementById('sellingPaintCubes');
      const maxCubesEl = document.getElementById('sellingMaxCubes');
      const collectBtn = document.getElementById('collectPaintBtn');
      const skipBtn = document.getElementById('skipCollectionBtn');
      
      if (!container) return;
      
      // Check if it's our turn to collect
      const currentCollector = sellingData.order[sellingData.currentIndex];
      const isMyTurn = currentCollector?.playerId === playerId;
      const maxCubes = isMyTurn ? Math.min(currentCollector.cubesPerAction, currentCollector.remainingCubes, paintMarket.length) : 0;
      
      if (maxCubesEl) maxCubesEl.textContent = maxCubes;
      if (collectBtn) collectBtn.disabled = !isMyTurn || selectedSellingCubes.length === 0;
      if (skipBtn) skipBtn.disabled = !isMyTurn;
      
      // Render cubes
      container.innerHTML = paintMarket.map(cube => `
        <div 
          class="paint-cube selectable ${selectedSellingCubes.includes(cube.id) ? 'selected' : ''} ${!isMyTurn ? 'disabled' : ''}"
          data-cube-id="${cube.id}"
          data-color="${cube.color}"
          data-is-wild="${cube.is_wild}"
          title="${cube.color}${cube.is_wild ? ' (Wild)' : ''}"
          onclick="toggleSellingCube('${cube.id}', ${maxCubes})"
        ></div>
      `).join('');
    }

    function toggleSellingCube(cubeId, maxCubes) {
      const index = selectedSellingCubes.indexOf(cubeId);
      if (index >= 0) {
        selectedSellingCubes.splice(index, 1);
      } else if (selectedSellingCubes.length < maxCubes) {
        selectedSellingCubes.push(cubeId);
      }
      updateSellingCubesUI();
    }

    function updateSellingCubesUI() {
      const countEl = document.getElementById('selectedCubeCount');
      const collectBtn = document.getElementById('collectPaintBtn');
      
      if (countEl) countEl.textContent = selectedSellingCubes.length;
      if (collectBtn) collectBtn.disabled = selectedSellingCubes.length === 0;
      
      // Update cube visual selection
      document.querySelectorAll('#sellingPaintCubes .paint-cube').forEach(el => {
        if (selectedSellingCubes.includes(el.dataset.cubeId)) {
          el.classList.add('selected');
        } else {
          el.classList.remove('selected');
        }
      });
    }

    function getPlayerName(playerId) {
      const players = gameUI?.gameState?.players || initialGameState.players;
      const player = players.find(p => p.id === playerId);
      return player?.name || 'A player';
    }

    function showWinModal(winner, finalScores) {
      const modal = document.createElement('div');
      modal.className = 'win-modal';
      modal.setAttribute('data-testid', 'win-modal');
      
      let scoresHTML = '';
      finalScores.sort((a, b) => b.score !== a.score ? b.score - a.score : b.paintings_completed - a.paintings_completed)
        .forEach((player, index) => {
          scoresHTML += `
            <div class="score-item ${player.id === winner.id ? 'winner' : ''}">
              <span>${index === 0 ? '1st' : index === 1 ? '2nd' : index === 2 ? '3rd' : ''} ${player.name} ${player.id === playerId ? '(You)' : ''}</span>
              <span>${player.score} pts | ${player.paintings_completed} paintings</span>
            </div>
          `;
        });
      
      modal.innerHTML = `
        <div class="win-content">
          <div class="win-icon">Winner</div>
          <h2 class="win-title">${winner.name} ${winner.id === playerId ? '(You) ' : ''}Wins!</h2>
          <p class="lead">Final Score: ${winner.score} points<br>Completed Paintings: ${winner.paintings_completed}</p>
          <div class="final-scores"><h4>Final Standings</h4>${scoresHTML}</div>
          <div class="mt-4"><a href="/" class="btn btn-primary btn-lg" data-testid="new-game-btn">New Game</a></div>
        </div>
      `;
      document.body.appendChild(modal);
    }
  </script>
  
  <%
    function getColorStyle(color) {
      const colors = {
        red: '#EF4444, #DC2626',
        orange: '#F97316, #EA580C',
        yellow: '#EAB308, #CA8A04',
        green: '#22C55E, #16A34A',
        blue: '#3B82F6, #2563EB',
        purple: '#A855F7, #9333EA',
        black: '#1F2937, #111827'
      };
      return colors[color] || '#888, #666';
    }
  %>
</body>
</html>












