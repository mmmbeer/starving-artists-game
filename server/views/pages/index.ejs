<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/themes/default.css">
  <link rel="stylesheet" href="/css/overrides.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <header class="app-header">
    <div class="container">
      <a href="/" class="app-logo">🎨 <span>Starving Artists</span></a>
      <nav class="header-nav">
        <a href="/rules" class="btn btn-sm btn-outline-primary">Rules</a>
        <a href="/about" class="btn btn-sm btn-outline-primary">About</a>
      </nav>
    </div>
  </header>

  <main class="app-main">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <h1 class="hero-title">Starving Artists</h1>
            <p class="hero-subtitle">
              Create masterpieces, manage your nutrition, and become the ultimate artist in this competitive multiplayer board game.
            </p>
            <div class="hero-stats">
              <div class="stat-item">
                <strong>2-4</strong>
                <span>Players</span>
              </div>
              <div class="stat-item">
                <strong>30-60</strong>
                <span>Minutes</span>
              </div>
              <div class="stat-item">
                <strong>Real-Time</strong>
                <span>Multiplayer</span>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <!-- Game Actions Card -->
            <div class="card shadow-lg">
              <div class="card-body p-4">
                <h2 class="card-title text-center mb-4">Start Playing</h2>
                
                <!-- Create Game Section -->
                <div class="mb-4">
                  <h5 class="mb-3">🎨 Create New Game</h5>
                  <form id="createGameForm">
                    <div class="mb-3">
                      <label for="createPlayerName" class="form-label">Your Name</label>
                      <input 
                        type="text" 
                        class="form-control" 
                        id="createPlayerName" 
                        placeholder="Enter your artist name" 
                        required
                        maxlength="50"
                        pattern="[a-zA-Z0-9\s\-_]+"
                        data-testid="create-player-name"
                      >
                      <div class="form-text">2-50 characters, alphanumeric only</div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100" id="createGameBtn" data-testid="create-game-btn">
                      <span class="btn-text">Create Game Lobby</span>
                      <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                    </button>
                  </form>
                </div>

                <div class="divider my-4">
                  <span>OR</span>
                </div>

                <!-- Join Game Section -->
                <div>
                  <h5 class="mb-3">🔗 Join Existing Game</h5>
                  <form id="joinGameForm">
                    <div class="mb-3">
                      <label for="joinPlayerName" class="form-label">Your Name</label>
                      <input 
                        type="text" 
                        class="form-control" 
                        id="joinPlayerName" 
                        placeholder="Enter your artist name" 
                        required
                        maxlength="50"
                        pattern="[a-zA-Z0-9\s\-_]+"
                        data-testid="join-player-name"
                      >
                    </div>
                    <div class="mb-3">
                      <label for="gameId" class="form-label">Game ID or URL</label>
                      <input 
                        type="text" 
                        class="form-control" 
                        id="gameId" 
                        placeholder="Paste game link or ID" 
                        required
                        data-testid="game-id-input"
                      >
                      <div class="form-text">Get this from your friend who created the game</div>
                    </div>
                    <button type="submit" class="btn btn-accent w-100" id="joinGameBtn" data-testid="join-game-btn">
                      <span class="btn-text">Join Game</span>
                      <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section py-5">
      <div class="container">
        <h2 class="text-center mb-5">How to Play</h2>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="feature-card text-center">
              <div class="feature-icon">🎨</div>
              <h4>Collect Paint</h4>
              <p>Draw paint cubes from the bag to build your collection</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="feature-card text-center">
              <div class="feature-icon">🖼️</div>
              <h4>Buy Canvases</h4>
              <p>Purchase canvases from the market to paint on</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="feature-card text-center">
              <div class="feature-icon">🖌️</div>
              <h4>Paint Masterpieces</h4>
              <p>Match colors to complete your paintings</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="feature-card text-center">
              <div class="feature-icon">🏆</div>
              <h4>Win the Game</h4>
              <p>Be the first to complete enough paintings or reach the point goal</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="app-footer">
    <div class="container text-center">
      <p>&copy; 2025 Starving Artists Online. Based on the board game by Fairway 3 Games, LLC.</p>
    </div>
  </footer>

  <!-- Toast Container -->
  <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/utils/ui-helpers.js"></script>
  <script>
    // Create Game Form Handler
    document.getElementById('createGameForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const playerName = document.getElementById('createPlayerName').value.trim();
      const btn = document.getElementById('createGameBtn');
      const btnText = btn.querySelector('.btn-text');
      const spinner = btn.querySelector('.spinner-border');
      
      // Disable button and show loading
      btn.disabled = true;
      btnText.textContent = 'Creating...';
      spinner.classList.remove('d-none');
      
      try {
        const response = await fetch('/lobby/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ playerName }),
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Show success message
          showToast('Success', 'Game created! Redirecting...', 'success');
          
          // Redirect to lobby
          setTimeout(() => {
            window.location.href = data.redirectUrl;
          }, 500);
        } else {
          throw new Error(data.error || 'Failed to create game');
        }
      } catch (error) {
        console.error('Create game error:', error);
        showToast('Error', error.message, 'danger');
        
        // Re-enable button
        btn.disabled = false;
        btnText.textContent = 'Create Game Lobby';
        spinner.classList.add('d-none');
      }
    });

    // Join Game Form Handler
    document.getElementById('joinGameForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const playerName = document.getElementById('joinPlayerName').value.trim();
      let gameId = document.getElementById('gameId').value.trim();
      
      // Extract game ID from URL if full URL is provided
      if (gameId.includes('lobby/')) {
        gameId = gameId.split('lobby/').pop().split('?')[0].split('#')[0];
      } else if (gameId.includes('game/')) {
        gameId = gameId.split('game/').pop().split('?')[0].split('#')[0];
      }
      
      const btn = document.getElementById('joinGameBtn');
      const btnText = btn.querySelector('.btn-text');
      const spinner = btn.querySelector('.spinner-border');
      
      // Disable button and show loading
      btn.disabled = true;
      btnText.textContent = 'Joining...';
      spinner.classList.remove('d-none');
      
      try {
        const response = await fetch(`/lobby/join/${gameId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ playerName }),
        });
        
        const data = await response.json();
        
        if (data.success) {
          // Show success message
          showToast('Success', 'Joined game! Redirecting...', 'success');
          
          // Redirect to lobby
          setTimeout(() => {
            window.location.href = data.redirectUrl;
          }, 500);
        } else {
          throw new Error(data.error || 'Failed to join game');
        }
      } catch (error) {
        console.error('Join game error:', error);
        showToast('Error', error.message, 'danger');
        
        // Re-enable button
        btn.disabled = false;
        btnText.textContent = 'Join Game';
        spinner.classList.add('d-none');
      }
    });
  </script>
</body>
</html>
