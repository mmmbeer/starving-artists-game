<!DOCTYPE html>\n<html lang=\"en\" data-theme=\"default\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title><%= title %></title>\n  \n  <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"/css/variables.css\">\n  <link rel=\"stylesheet\" href=\"/css/themes/default.css\">\n  <link rel=\"stylesheet\" href=\"/css/overrides.css\">\n  <link rel=\"stylesheet\" href=\"/css/main.css\">\n  <link rel=\"stylesheet\" href=\"/css/layout.css\">\n  <link rel=\"stylesheet\" href=\"/css/components.css\">\n  <link rel=\"stylesheet\" href=\"/css/lobby.css\">\n</head>\n<body>\n  <header class=\"app-header\">\n    <div class=\"container\">\n      <a href=\"/\" class=\"app-logo\">\ud83c\udfa8 <span>Starving Artists</span></a>\n    </div>\n  </header>\n\n  <main class=\"app-main\">\n    <div class=\"container\">\n      <div class=\"row justify-content-center\">\n        <div class=\"col-lg-8\">\n          <!-- Lobby Header -->\n          <div class=\"lobby-header text-center mb-4\">\n            <h1 class=\"display-5 mb-3\">Game Lobby</h1>\n            <p class=\"lead\">Waiting for players to join...</p>\n            \n            <!-- Game Link Sharing -->\n            <div class=\"game-link-container card p-3 mb-3\">\n              <label class=\"form-label fw-bold\">Invite Players:</label>\n              <div class=\"input-group\">\n                <input \n                  type=\"text\" \n                  class=\"form-control\" \n                  id=\"gameLink\" \n                  value=\"<%= game ? `${game.id}` : '' %>\" \n                  readonly\n                >\n                <button class=\"btn btn-accent\" id=\"copyLinkBtn\" type=\"button\">\n                  <span class=\"copy-text\">\ud83d\udccb Copy Link</span>\n                  <span class=\"copied-text d-none\">\u2705 Copied!</span>\n                </button>\n              </div>\n              <small class=\"text-muted mt-2 d-block\">Share this link with friends to invite them</small>\n            </div>\n          </div>\n\n          <!-- Players List -->\n          <div class=\"card shadow-lg mb-4\">\n            <div class=\"card-header\">\n              <h5 class=\"mb-0\">\n                <span class=\"me-2\">\ud83d\udc65</span>\n                Players (<span id=\"playerCount\"><%= players.length %></span>/4)\n              </h5>\n            </div>\n            <div class=\"card-body\">\n              <div id=\"playersList\" class=\"players-list\">\n                <% players.forEach((player, index) => { %>\n                  <div class=\"player-item <%= currentPlayer && player.id === currentPlayer.id ? 'current-player' : '' %>\" data-player-id=\"<%= player.id %>\">\n                    <div class=\"player-avatar\">\n                      <%= player.name.charAt(0).toUpperCase() %>\n                    </div>\n                    <div class=\"player-info\">\n                      <div class=\"player-name\">\n                        <%= player.name %>\n                        <% if (player.is_host) { %>\n                          <span class=\"badge bg-warning text-dark ms-2\">Host</span>\n                        <% } %>\n                        <% if (currentPlayer && player.id === currentPlayer.id) { %>\n                          <span class=\"badge bg-primary ms-2\">You</span>\n                        <% } %>\n                      </div>\n                      <div class=\"player-status\">\n                        <span class=\"status-indicator <%= player.connected ? 'online' : 'offline' %>\"></span>\n                        <%= player.connected ? 'Online' : 'Offline' %>\n                      </div>\n                    </div>\n                  </div>\n                <% }); %>\n                \n                <!-- Empty slots -->\n                <% for (let i = players.length; i < 4; i++) { %>\n                  <div class=\"player-item empty-slot\">\n                    <div class=\"player-avatar empty\">\n                      ?\n                    </div>\n                    <div class=\"player-info\">\n                      <div class=\"player-name text-muted\">Waiting for player...</div>\n                      <div class=\"player-status text-muted\">Empty slot</div>\n                    </div>\n                  </div>\n                <% } %>\n              </div>\n            </div>\n          </div>\n\n          <!-- Game Controls -->\n          <div class=\"lobby-controls\">\n            <% if (isHost) { %>\n              <button \n                id=\"startGameBtn\" \n                class=\"btn btn-primary btn-lg w-100 mb-3\" \n                <%= canStart ? '' : 'disabled' %>\n              >\n                <span class=\"btn-text\">\n                  <% if (canStart) { %>\n                    \ud83c\udfae Start Game\n                  <% } else { %>\n                    \u23f3 Need at least 2 players to start\n                  <% } %>\n                </span>\n                <span class=\"spinner-border spinner-border-sm d-none\" role=\"status\"></span>\n              </button>\n            <% } else { %>\n              <div class=\"alert alert-info text-center\">\n                \u23f3 Waiting for host to start the game...\n              </div>\n            <% } %>\n            \n            <button id=\"leaveLobbyBtn\" class=\"btn btn-outline-danger w-100\">\n              \u274c Leave Lobby\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <footer class=\"app-footer\">\n    <div class=\"container text-center\">\n      <p>&copy; 2025 Starving Artists Online</p>\n    </div>\n  </footer>\n\n  <!-- Toast Container -->\n  <div class=\"toast-container position-fixed top-0 end-0 p-3\" id=\"toastContainer\"></div>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\n  <script src=\"/socket.io/socket.io.js\"></script>\n  <script src=\"/js/utils/ui-helpers.js\"></script>\n  <script>\n    // Game and player data from server\n    const gameId = '<%= game.id %>';\n    const playerId = '<%= currentPlayer ? currentPlayer.id : \"\" %>';\n    const isHost = <%= isHost %>;\n    \n    // Initialize Socket.IO\n    const socket = io({\n      path: '/socket.io',\n      reconnection: true,\n      reconnectionDelay: 1000,\n      reconnectionAttempts: 5\n    });\n\n    // Connection status\n    socket.on('connect', () => {\n      console.log('Connected to server');\n      // Join lobby room\n      socket.emit('join-lobby', { gameId, playerId });\n    });\n\n    socket.on('disconnect', () => {\n      console.log('Disconnected from server');\n      showToast('Connection Lost', 'Attempting to reconnect...', 'warning');\n    });\n\n    // Lobby state updates\n    socket.on('lobby-state', (lobbyInfo) => {\n      console.log('Lobby state updated:', lobbyInfo);\n      updatePlayersList(lobbyInfo.players);\n      updateStartButton(lobbyInfo.canStart);\n    });\n\n    // Player joined\n    socket.on('player-joined', (data) => {\n      console.log('Player joined:', data);\n      showToast('Player Joined', `${data.player.name} joined the lobby`, 'success');\n      // Request updated state\n      socket.emit('request-lobby-state', { gameId });\n    });\n\n    // Player left\n    socket.on('player-left', (data) => {\n      console.log('Player left:', data);\n      showToast('Player Left', 'A player left the lobby', 'info');\n      // Request updated state\n      socket.emit('request-lobby-state', { gameId });\n    });\n\n    // Lobby closed (host left)\n    socket.on('lobby-closed', () => {\n      showToast('Lobby Closed', 'The host closed the lobby. Redirecting...', 'warning');\n      setTimeout(() => {\n        window.location.href = '/';\n      }, 2000);\n    });\n\n    // Game starting redirect\n    let isStarting = false;\n    socket.on('game-starting', (data) => {\n      if (!isStarting) {\n        isStarting = true;\n        showToast('Game Starting!', 'Loading game board...', 'success');\n        setTimeout(() => {\n          window.location.href = `/game/${gameId}`;\n        }, 1000);\n      }\n    });\n\n    // Copy link button\n    document.getElementById('copyLinkBtn').addEventListener('click', () => {\n      const gameLink = document.getElementById('gameLink');\n      const fullLink = window.location.origin + '/lobby/' + gameLink.value;\n      \n      navigator.clipboard.writeText(fullLink).then(() => {\n        const btn = document.getElementById('copyLinkBtn');\n        const copyText = btn.querySelector('.copy-text');\n        const copiedText = btn.querySelector('.copied-text');\n        \n        copyText.classList.add('d-none');\n        copiedText.classList.remove('d-none');\n        \n        setTimeout(() => {\n          copyText.classList.remove('d-none');\n          copiedText.classList.add('d-none');\n        }, 2000);\n      }).catch(err => {\n        console.error('Failed to copy:', err);\n        gameLink.select();\n        document.execCommand('copy');\n      });\n    });\n\n    // Start game button\n    if (isHost) {\n      document.getElementById('startGameBtn').addEventListener('click', async () => {\n        const btn = document.getElementById('startGameBtn');\n        const btnText = btn.querySelector('.btn-text');\n        const spinner = btn.querySelector('.spinner-border');\n        \n        btn.disabled = true;\n        btnText.textContent = 'Starting game...';\n        spinner.classList.remove('d-none');\n        \n        try {\n          const response = await fetch(`/lobby/${gameId}/start`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n          });\n          \n          const data = await response.json();\n          \n          if (data.success) {\n            // Emit socket event to notify all players\n            socket.emit('game-starting', { gameId });\n            showToast('Success', 'Game starting!', 'success');\n            \n            setTimeout(() => {\n              window.location.href = data.redirectUrl;\n            }, 500);\n          } else {\n            throw new Error(data.error || 'Failed to start game');\n          }\n        } catch (error) {\n          console.error('Start game error:', error);\n          showToast('Error', error.message, 'danger');\n          \n          btn.disabled = false;\n          btnText.textContent = '\ud83c\udfae Start Game';\n          spinner.classList.add('d-none');\n        }\n      });\n    }\n\n    // Leave lobby button\n    document.getElementById('leaveLobbyBtn').addEventListener('click', async () => {\n      if (confirm('Are you sure you want to leave?')) {\n        try {\n          // Emit leave event\n          socket.emit('leave-lobby', { gameId, playerId });\n          \n          const response = await fetch(`/lobby/${gameId}/leave`, {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n          });\n          \n          const data = await response.json();\n          \n          if (data.success) {\n            window.location.href = data.redirectUrl;\n          }\n        } catch (error) {\n          console.error('Leave lobby error:', error);\n          window.location.href = '/';\n        }\n      }\n    });\n\n    // Update players list\n    function updatePlayersList(players) {\n      const playersList = document.getElementById('playersList');\n      const playerCount = document.getElementById('playerCount');\n      \n      playerCount.textContent = players.length;\n      \n      let html = '';\n      players.forEach(player => {\n        const isCurrent = player.id === playerId;\n        html += `\n          <div class=\"player-item ${isCurrent ? 'current-player' : ''}\" data-player-id=\"${player.id}\">\n            <div class=\"player-avatar\">\n              ${player.name.charAt(0).toUpperCase()}\n            </div>\n            <div class=\"player-info\">\n              <div class=\"player-name\">\n                ${player.name}\n                ${player.is_host ? '<span class=\"badge bg-warning text-dark ms-2\">Host</span>' : ''}\n                ${isCurrent ? '<span class=\"badge bg-primary ms-2\">You</span>' : ''}\n              </div>\n              <div class=\"player-status\">\n                <span class=\"status-indicator ${player.connected ? 'online' : 'offline'}\"></span>\n                ${player.connected ? 'Online' : 'Offline'}\n              </div>\n            </div>\n          </div>\n        `;\n      });\n      \n      // Add empty slots\n      for (let i = players.length; i < 4; i++) {\n        html += `\n          <div class=\"player-item empty-slot\">\n            <div class=\"player-avatar empty\">?</div>\n            <div class=\"player-info\">\n              <div class=\"player-name text-muted\">Waiting for player...</div>\n              <div class=\"player-status text-muted\">Empty slot</div>\n            </div>\n          </div>\n        `;\n      }\n      \n      playersList.innerHTML = html;\n    }\n\n    // Update start button state\n    function updateStartButton(canStart) {\n      if (!isHost) return;\n      \n      const btn = document.getElementById('startGameBtn');\n      const btnText = btn.querySelector('.btn-text');\n      \n      if (canStart) {\n        btn.disabled = false;\n        btnText.textContent = '\ud83c\udfae Start Game';\n      } else {\n        btn.disabled = true;\n        btnText.textContent = '\u23f3 Need at least 2 players to start';\n      }\n    }\n\n    // Ping server to keep connection alive\n    setInterval(() => {\n      if (socket.connected) {\n        socket.emit('ping');\n      }\n    }, 30000);\n  </script>\n</body>\n</html>\n
