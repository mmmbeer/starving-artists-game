<!DOCTYPE html>
<html lang="en" data-theme="default">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/variables.css">
  <link rel="stylesheet" href="/css/themes/default.css">
  <link rel="stylesheet" href="/css/overrides.css">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/lobby.css">
</head>
<body>
  <header class="app-header">
    <div class="container">
      <a href="/" class="app-logo">🎨 <span>Starving Artists</span></a>
    </div>
  </header>

  <main class="app-main">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <!-- Lobby Header -->
          <div class="lobby-header text-center mb-4">
            <h1 class="display-5 mb-3">Game Lobby</h1>
            <p class="lead">Waiting for players to join...</p>
            
            <!-- Game Link Sharing -->
            <div class="game-link-container card p-3 mb-3">
              <label class="form-label fw-bold">Invite Players:</label>
              <div class="input-group">
                <input 
                  type="text" 
                  class="form-control" 
                  id="gameLink" 
                  value="<%= game ? game.id : '' %>" 
                  readonly
                  data-testid="game-link-input"
                >
                <button class="btn btn-accent" id="copyLinkBtn" type="button" data-testid="copy-link-btn">
                  <span class="copy-text">📋 Copy Link</span>
                  <span class="copied-text d-none">✅ Copied!</span>
                </button>
              </div>
              <small class="text-muted mt-2 d-block">Share this link with friends to invite them</small>
            </div>
          </div>

          <% if (!currentPlayer) { %>
            <div class="card shadow-sm mb-4">
              <div class="card-body">
                <h5 class="mb-3">Join This Lobby</h5>
                <form id="joinLobbyForm">
                  <label for="joinLobbyPlayerName" class="form-label">Your Name</label>
                  <div class="input-group">
                    <input 
                      type="text" 
                      class="form-control" 
                      id="joinLobbyPlayerName" 
                      placeholder="Enter your artist name" 
                      required
                      maxlength="50"
                      data-testid="join-lobby-player-name"
                    >
                    <button class="btn btn-outline-secondary" id="randomLobbyNameBtn" type="button" title="Random name">
                      🎲
                    </button>
                  </div>
                  <div class="form-text">2-50 characters (letters, numbers, spaces, dashes, underscores, commas)</div>
                  <button type="submit" class="btn btn-accent w-100 mt-3" id="joinLobbyBtn" data-testid="join-lobby-btn">
                    <span class="btn-text">Join Lobby</span>
                    <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                  </button>
                </form>
              </div>
            </div>
          <% } %>

          <!-- Players List -->
          <div class="card shadow-lg mb-4">
            <div class="card-header">
              <h5 class="mb-0">
                <span class="me-2">👥</span>
                Players (<span id="playerCount"><%= players.length %></span>/4)
              </h5>
            </div>
            <div class="card-body">
              <div id="playersList" class="players-list" data-testid="players-list">
                <% players.forEach((player, index) => { %>
                  <div class="player-item <%= currentPlayer && player.id === currentPlayer.id ? 'current-player' : '' %>" data-player-id="<%= player.id %>">
                    <div class="player-line">
                      <span class="player-number">#<%= index + 1 %></span>
                      <span class="player-name"><%= player.name %></span>
                      <span class="player-badge"><%= player.is_host ? 'host' : 'player' %></span>
                      <span class="player-status-pill <%= player.connected ? 'status-online' : 'status-offline' %>">
                        <span class="status-dot <%= player.connected ? 'status-online' : 'status-offline' %>"></span>
                        <%= player.connected ? 'Online' : 'Offline' %>
                      </span>
                    </div>
                  </div>
                <% }); %>
                
                <!-- Empty slots -->
                <% for (let i = players.length; i < 4; i++) { %>
                  <div class="player-item empty-slot">
                    <div class="player-line">
                      <span class="player-number">#<%= i + 1 %></span>
                      <span class="player-name text-muted">Waiting on player...</span>
                      <span class="player-badge">player</span>
                      <span class="player-status-pill status-empty">
                        <span class="status-dot status-empty"></span>
                        Empty
                      </span>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- Game Controls -->
          <div class="lobby-controls">
            <% if (isHost) { %>
              <button 
                id="startGameBtn" 
                class="btn btn-primary btn-lg w-100 mb-3" 
                <%= canStart ? '' : 'disabled' %>
                data-testid="start-game-btn"
              >
                <span class="btn-text">
                  <% if (canStart) { %>
                    🎮 Start Game
                  <% } else { %>
                    ⏳ Need at least 2 players to start
                  <% } %>
                </span>
                <span class="spinner-border spinner-border-sm d-none" role="status"></span>
              </button>
            <% } else { %>
              <div class="alert alert-info text-center">
                ⏳ Waiting for host to start the game...
              </div>
            <% } %>
            
            <button id="leaveLobbyBtn" class="btn btn-outline-danger w-100" data-testid="leave-lobby-btn">
              ❌ Leave Lobby
            </button>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="app-footer">
    <div class="container text-center">
      <p>&copy; 2025 Starving Artists Online</p>
    </div>
  </footer>

  <!-- Toast Container -->
  <div class="toast-container position-fixed top-0 end-0 p-3" id="toastContainer"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/utils/ui-helpers.js"></script>
  <script type="module">
    import { randomName } from '/js/utils/random-name.js';
    window.randomName = randomName;
  </script>
  <script>
    // Game and player data from server
    const gameId = '<%= game.id %>';
    const playerId = '<%= currentPlayer ? currentPlayer.id : "" %>';
    const isHost = <%= isHost %>;
    const hasPlayer = !!playerId;
    
    // Initialize Socket.IO
    const socket = io({
      path: '/socket.io',
      reconnection: true,
      reconnectionDelay: 1000,
      reconnectionAttempts: 5
    });

    // Connection status
    socket.on('connect', () => {
      console.log('Connected to server');
      // Join lobby room
      if (hasPlayer) {
        socket.emit('join-lobby', { gameId, playerId });
      }
    });

    socket.on('disconnect', () => {
      console.log('Disconnected from server');
      showToast('Connection Lost', 'Attempting to reconnect...', 'warning');
    });

    // Lobby state updates
    socket.on('lobby-state', (lobbyInfo) => {
      console.log('Lobby state updated:', lobbyInfo);
      updatePlayersList(lobbyInfo.players);
      updateStartButton(lobbyInfo.canStart);
    });

    // Player joined
    socket.on('player-joined', (data) => {
      console.log('Player joined:', data);
      showToast('Player Joined', `${data.player.name} joined the lobby`, 'success');
      // Request updated state
      socket.emit('request-lobby-state', { gameId });
    });

    // Player left
    socket.on('player-left', (data) => {
      console.log('Player left:', data);
      showToast('Player Left', 'A player left the lobby', 'info');
      // Request updated state
      socket.emit('request-lobby-state', { gameId });
    });

    // Lobby closed (host left)
    socket.on('lobby-closed', () => {
      showToast('Lobby Closed', 'The host closed the lobby. Redirecting...', 'warning');
      setTimeout(() => {
        window.location.href = '/';
      }, 2000);
    });

    // Game starting redirect
    let isStarting = false;
    socket.on('game-starting', (data) => {
      if (!isStarting) {
        isStarting = true;
        showToast('Game Starting!', 'Loading game board...', 'success');
        setTimeout(() => {
          window.location.href = `/game/${gameId}`;
        }, 1000);
      }
    });

    // Copy link button
    document.getElementById('copyLinkBtn').addEventListener('click', () => {
      const gameLink = document.getElementById('gameLink');
      const fullLink = window.location.origin + '/lobby/' + gameLink.value;
      
      navigator.clipboard.writeText(fullLink).then(() => {
        const btn = document.getElementById('copyLinkBtn');
        const copyText = btn.querySelector('.copy-text');
        const copiedText = btn.querySelector('.copied-text');
        
        copyText.classList.add('d-none');
        copiedText.classList.remove('d-none');
        
        setTimeout(() => {
          copyText.classList.remove('d-none');
          copiedText.classList.add('d-none');
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy:', err);
        gameLink.select();
        document.execCommand('copy');
      });
    });

    const joinLobbyForm = document.getElementById('joinLobbyForm');
    if (joinLobbyForm) {
      const joinLobbyBtn = document.getElementById('joinLobbyBtn');
      const joinLobbyBtnText = joinLobbyBtn.querySelector('.btn-text');
      const joinLobbySpinner = joinLobbyBtn.querySelector('.spinner-border');
      const joinLobbyNameInput = document.getElementById('joinLobbyPlayerName');
      const randomLobbyNameBtn = document.getElementById('randomLobbyNameBtn');

      if (randomLobbyNameBtn) {
        randomLobbyNameBtn.addEventListener('click', () => {
          if (window.randomName) {
            joinLobbyNameInput.value = window.randomName();
            joinLobbyNameInput.focus();
          }
        });
      }

      joinLobbyForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const playerName = joinLobbyNameInput.value.trim();
        if (!playerName || playerName.length < 2 || playerName.length > 50) {
          showToast('Invalid Name', 'Name must be 2-50 characters (letters, numbers, spaces, dashes, underscores, commas).', 'warning');
          return;
        }

        joinLobbyBtn.disabled = true;
        joinLobbyBtnText.textContent = 'Joining...';
        joinLobbySpinner.classList.remove('d-none');

        try {
          const response = await fetch(`/lobby/join/${gameId}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ playerName }),
          });

          const data = await response.json();

          if (data.success) {
            showToast('Success', 'Joined lobby!', 'success');
            setTimeout(() => {
              window.location.href = data.redirectUrl || `/lobby/${gameId}`;
            }, 300);
          } else {
            throw new Error(data.error || 'Failed to join lobby');
          }
        } catch (error) {
          console.error('Join lobby error:', error);
          showToast('Error', error.message, 'danger');
          joinLobbyBtn.disabled = false;
          joinLobbyBtnText.textContent = 'Join Lobby';
          joinLobbySpinner.classList.add('d-none');
        }
      });
    }

    // Start game button
    if (isHost) {
      document.getElementById('startGameBtn').addEventListener('click', async () => {
        const btn = document.getElementById('startGameBtn');
        const btnText = btn.querySelector('.btn-text');
        const spinner = btn.querySelector('.spinner-border');
        
        btn.disabled = true;
        btnText.textContent = 'Starting game...';
        spinner.classList.remove('d-none');
        
        try {
          const response = await fetch(`/lobby/${gameId}/start`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Emit socket event to notify all players
            socket.emit('game-starting', { gameId });
            showToast('Success', 'Game starting!', 'success');
            
            setTimeout(() => {
              window.location.href = data.redirectUrl;
            }, 500);
          } else {
            throw new Error(data.error || 'Failed to start game');
          }
        } catch (error) {
          console.error('Start game error:', error);
          showToast('Error', error.message, 'danger');
          
          btn.disabled = false;
          btnText.textContent = '🎮 Start Game';
          spinner.classList.add('d-none');
        }
      });
    }

    // Leave lobby button
    document.getElementById('leaveLobbyBtn').addEventListener('click', async () => {
      if (confirm('Are you sure you want to leave?')) {
        try {
          // Emit leave event
          socket.emit('leave-lobby', { gameId, playerId });
          
          const response = await fetch(`/lobby/${gameId}/leave`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          });
          
          const data = await response.json();
          
          if (data.success) {
            window.location.href = data.redirectUrl;
          }
        } catch (error) {
          console.error('Leave lobby error:', error);
          window.location.href = '/';
        }
      }
    });

    // Update players list
    function updatePlayersList(players) {
      const playersList = document.getElementById('playersList');
      const playerCount = document.getElementById('playerCount');
      
      playerCount.textContent = players.length;
      
      let html = '';
      players.forEach((player, index) => {
        const isCurrent = player.id === playerId;
        html += `
          <div class="player-item ${isCurrent ? 'current-player' : ''}" data-player-id="${player.id}">
            <div class="player-line">
              <span class="player-number">#${index + 1}</span>
              <span class="player-name">${player.name}</span>
              <span class="player-badge">${player.is_host ? 'host' : 'player'}</span>
              <span class="player-status-pill ${player.connected ? 'status-online' : 'status-offline'}">
                <span class="status-dot ${player.connected ? 'status-online' : 'status-offline'}"></span>
                ${player.connected ? 'Online' : 'Offline'}
              </span>
            </div>
          </div>
        `;
      });
      
      // Add empty slots
      for (let i = players.length; i < 4; i++) {
        html += `
          <div class="player-item empty-slot">
            <div class="player-line">
              <span class="player-number">#${i + 1}</span>
              <span class="player-name text-muted">Waiting on player...</span>
              <span class="player-badge">player</span>
              <span class="player-status-pill status-empty">
                <span class="status-dot status-empty"></span>
                Empty
              </span>
            </div>
          </div>
        `;
      }
      
      playersList.innerHTML = html;
    }

    // Update start button state
    function updateStartButton(canStart) {
      if (!isHost) return;
      
      const btn = document.getElementById('startGameBtn');
      const btnText = btn.querySelector('.btn-text');
      
      if (canStart) {
        btn.disabled = false;
        btnText.textContent = '🎮 Start Game';
      } else {
        btn.disabled = true;
        btnText.textContent = '⏳ Need at least 2 players to start';
      }
    }

    // Ping server to keep connection alive
    setInterval(() => {
      if (socket.connected) {
        socket.emit('ping');
      }
    }, 30000);
  </script>
</body>
</html>
